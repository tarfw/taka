# TAKA Scientific ERP & AI Agent Configuration

# Port
PORT=3000

# Turso (libSQL) Database
# For local development without Turso, leave blank or set to file:taka.db
TURSO_DATABASE_URL=file:taka.db
TURSO_AUTH_TOKEN=
# In production with Turso Cloud:
# TURSO_DATABASE_URL=libsql://taka-erp-yourorg.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Google Gemini API (for AI Agent, RFQ parser, conversational ERP)
GEMINI_API_KEY=

# (Optional) Groq API Key (for sub-second chat replies)
GROQ_API_KEY=

# Zoho ZeptoMail API (for sending official Quote, PO, Invoice PDFs)
# Obtain from ZeptoMail Console -> Mail Agents -> Setup info -> Send Mail Token
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_SEND_MAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=quotes@taka.ae
ZEPTOMAIL_FROM_NAME=TAKA Scientific Equipments

# Zoho Cliq Integration
# Incoming Webhook URL to post alerts into your #sales or #finance channel
ZOHO_CLIQ_INCOMING_WEBHOOK_URL=
# Secret token to verify incoming requests from Zoho Cliq bot/slash commands
ZOHO_CLIQ_VERIFICATION_TOKEN=

# Company Details (TAKA Scientific)
COMPANY_NAME=TAKA SCIENTIFIC EQUIPMENT - L.L.C
COMPANY_NAME_AR=تاكا للمعدات العلمية - ذ.م.م
COMPANY_TRN=100482910400003
COMPANY_LICENSE=CN-2849102
COMPANY_COMMERCIAL_REG=1012000000006736354
COMPANY_PHONE=+971 55 853 1705
COMPANY_EMAIL=sales@taka.ae
COMPANY_WEBSITE=https://taka.ae
COMPANY_HQ=Al Dana, Sector East 11, Building: Al Khazna Insurance Company, P.O. Box 73343, Abu Dhabi, UAE
