---
import ProductCardMini from './ProductCardMini.astro';

interface Spec {
  key: string;
  value: string;
}

interface Product {
  id: string;
  name: string;
  fullName?: string;
  brand: string;
  subcategory: string;
  description: string;
  fullDescription?: string;
  specs: Spec[];
  applications?: string[];
  image: string;
  gallery?: string[];
}

interface RelatedProduct extends Product {
  brandName?: string;
  subcategoryName?: string;
}

interface Props {
  product: Product;
  categoryId?: string;
  categoryName?: string;
  brandName?: string;
  brandUrl?: string;
  subcategoryName?: string;
  relatedProducts?: RelatedProduct[];
}

const { product, categoryId, categoryName, brandName, brandUrl, subcategoryName, relatedProducts = [] } = Astro.props;

const metaParts = [categoryName, brandName, subcategoryName].filter(Boolean);
---

<article class="ice-page">

  <!-- HEADER — breadcrumb -->
  <header class="ice-detail-head" data-view>
    <a href={categoryId ? `/catalogue/${categoryId}` : '/'} class="ice-detail-back t--fade">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Back to {categoryName || 'All products'}</span>
    </a>
    {metaParts.length > 0 && (
      <div class="ice-detail-meta t--fade">{metaParts.join(' / ')}</div>
    )}
  </header>

  <!-- HERO — editorial product shot -->
  <section class="ice-detail-hero" data-view>
    <div class="ice-detail-shot clip--top_left">
      <img src={product.image} alt={product.fullName || product.name} decoding="async" />
      <span class="ice-shot-mark ice-shot-mark--tl" aria-hidden="true"></span>
      <span class="ice-shot-mark ice-shot-mark--br" aria-hidden="true"></span>
    </div>
    <div class="ice-detail-info t--fade">
      <div class="ice-detail-eyebrow">
        {brandName && <span class="ice-detail-brand">{brandName}</span>}
        {subcategoryName && <span class="ice-detail-crumb">{subcategoryName}</span>}
      </div>
      <h1 class="ice-detail-title">{product.fullName || product.name}</h1>
      <p class="ice-detail-desc">{product.description}</p>
      <div class="ice-detail-actions">
        <a href="/contact" class="ice-btn"><span>Request a quote</span></a>
      </div>
      <div class="ice-detail-facts">
        <span>Authorized distributor</span>
        <span>ASTM &amp; ISO compliant</span>
        <span>Application support that lasts</span>
      </div>
    </div>
  </section>

  <!-- KEY SPECIFICATIONS -->
  {product.specs && product.specs.length > 0 && (
    <section class="ice-detail-specs" data-view>
      <div class="ice-block t--fade">
        <div class="ice-detail-section-title"><span>Key specifications</span></div>
        <div class="ice-specs-grid">
          {product.specs.slice(0, 4).map((spec) => (
            <div class="ice-spec-cell">
              <span class="ice-spec-key">{spec.key}</span>
              <span class="ice-spec-value">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- COMPLETE SPECIFICATIONS -->
  {product.specs && product.specs.length > 4 && (
    <section class="ice-detail-fullspecs" data-view>
      <div class="ice-block t--fade">
        <div class="ice-detail-section-title"><span>Complete specifications</span></div>
        <div class="ice-specs-table">
          {product.specs.map((spec) => (
            <div class="ice-specs-row">
              <span class="ice-specs-key">{spec.key}</span>
              <span class="ice-specs-value">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- APPLICATIONS -->
  {product.applications && product.applications.length > 0 && (
    <section class="ice-detail-apps" data-view>
      <div class="ice-block t--fade">
        <div class="ice-detail-section-title"><span>Applications</span></div>
        <div class="ice-apps-list">
          {product.applications.map((app) => (
            <span class="ice-app-tag">{app}</span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  {product.fullDescription && (
    <section class="ice-detail-about" data-view>
      <div class="ice-detail-about-inner t--fade">
        <div class="ice-detail-about-label">About this product</div>
        <p class="ice-detail-about-text">{product.fullDescription}</p>
      </div>
    </section>
  )}

  <!-- RELATED PRODUCTS -->
  {relatedProducts.length > 0 && (
    <section class="ice-slider-section" data-view>
      <div class="ice-block t--fade">
      <div class="ice-slider">
        <div class="ice-slider-title">
          <div class="ice-slider-title-wrapper"><h2>Related products</h2></div>
          <div class="ice-slider-controls">
            <button class="ice-slider-prev" aria-label="Previous" disabled>Prev</button>
            <button class="ice-slider-next" aria-label="Next" disabled>Next</button>
          </div>
        </div>
        <div class="ice-slider-items">
          <div class="ice-slider-track">
            {relatedProducts.map(rp => (
              <div class="ice-slider-item">
                <ProductCardMini
                  id={rp.id}
                  name={rp.name}
                  fullName={rp.fullName}
                  brandName={rp.brandName}
                  subcategoryName={rp.subcategoryName}
                  image={rp.image}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
      </div>
    </section>
  )}

  <!-- CONTACT CTA -->
  <section class="ice-cta" data-view>
    <div class="ice-block t--fade">
      <h2>Ready to specify this model?</h2>
      <p>Tell us about your application and we&#39;ll confirm availability and pricing.</p>
      <a href="/contact" class="ice-btn ice-btn-white"><span>Talk to our team</span></a>
    </div>
  </section>

</article>

<script>
  document.querySelectorAll('.ice-slider').forEach(slider => {
    const scroller = slider.querySelector('.ice-slider-items');
    const prev = slider.querySelector('.ice-slider-prev');
    const next = slider.querySelector('.ice-slider-next');
    if (!scroller || !prev || !next) return;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      prev.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= max - 1;
    };
    const step = () => {
      const item = scroller.querySelector('.ice-slider-item');
      return item ? item.offsetWidth : scroller.clientWidth;
    };

    prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', update, { passive: true });
    update();
    window.addEventListener('resize', update);
  });
</script>

<style>
  .ice-page {
    --ice-pad: 24px;
    --ice-black: #262626;
    --ice-white: #ffffff;
    --ice-border: #ececec;
    --ice-image-bg: #ffffff;
    --ice-sans: var(--font-sans);
    --ice-mono: var(--font-mono);
    --ice-btn-height: 32px;
    --ice-opacity: 0.35;
    --ice-underline-offset: 0.3em;
    --ice-ease: cubic-bezier(0.16, 1, 0.3, 1);
    flex-direction: column;
    gap: clamp(56px, 9vw, 96px);
    display: flex;
    background: var(--ice-white);
    color: var(--ice-black);
    font-size: 10px;
  }
  @media (max-width: 1024px) { .ice-page { --ice-gap: 56px; } }

  /* HEADER */
  .ice-detail-head {
    padding: 28px var(--ice-pad) 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    display: flex;
  }
  @media (max-width: 620px) { .ice-detail-head { flex-direction: column; align-items: flex-start; } }
  .ice-detail-back {
    align-items: center;
    gap: 10px;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    color: inherit;
    text-decoration: none;
  }
  @media (hover: hover) {
    .ice-detail-back:hover { text-underline-offset: var(--ice-underline-offset); text-decoration: underline; }
  }
  .ice-detail-meta {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    opacity: var(--ice-opacity);
  }

  /* HERO */
  .ice-detail-hero { display: grid; grid-template-columns: repeat(2, 1fr); min-height: 0; }
  @media (max-width: 900px) { .ice-detail-hero { grid-template-columns: 1fr; } }
  .ice-detail-shot {
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex: 0 0 auto;
    background: var(--ice-white);
  }
  .ice-detail-shot img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 420px);
    max-height: min(100%, 420px);
    object-fit: contain;
  }
  .ice-shot-mark {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0.45;
    pointer-events: none;
  }
  .ice-shot-mark--tl {
    top: 20px;
    left: 20px;
    border-top: 1px solid currentColor;
    border-left: 1px solid currentColor;
  }
  .ice-shot-mark--br {
    bottom: 20px;
    right: 20px;
    border-bottom: 1px solid currentColor;
    border-right: 1px solid currentColor;
  }
  @media (max-width: 900px) { .ice-detail-shot { height: 380px; } }
  .ice-detail-info {
    padding: clamp(32px, 4vw, 56px) var(--ice-pad);
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 22px;
    display: flex;
  }
  .ice-detail-eyebrow {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    color: var(--ice-black);
    opacity: 0.85;
    flex-flow: wrap;
    align-items: center;
    gap: 10px;
    display: flex;
  }
  .ice-detail-brand { color: #1a365d; font-weight: 500; }
  .ice-detail-crumb { position: relative; }
  .ice-detail-crumb::before {
    content: "/";
    position: absolute;
    left: -9px;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.4;
  }
  .ice-detail-facts {
    width: 100%;
    padding-top: 22px;
    border-top: 1px solid var(--ice-border);
    flex-flow: wrap;
    gap: 8px 26px;
    display: flex;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 1.4;
    opacity: 0.85;
  }
  .ice-detail-facts span { position: relative; }
  .ice-detail-facts span + span::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #1a365d;
    opacity: 0.5;
    position: absolute;
    left: -13px;
    top: 50%;
    transform: translateY(-50%);
  }
  .ice-detail-title {
    font-family: var(--ice-sans);
    letter-spacing: -0.02em;
    font-size: 34px;
    line-height: 1.02;
    font-weight: 600;
    margin: 0;
    max-width: 18ch;
  }
  @media (min-width: 1024px) {
    .ice-detail-title { letter-spacing: -0.03em; font-size: clamp(48px, 6vw, 84px); line-height: 0.92; }
  }
  .ice-detail-desc {
    font-family: var(--ice-sans);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
    opacity: 0.75;
    max-width: 46ch;
  }
  .ice-detail-actions { flex-flow: wrap; gap: 12px; display: flex; }

  /* BUTTONS */
  .ice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: var(--ice-black);
    color: var(--ice-white);
    height: var(--ice-btn-height);
    padding: 0 36px;
    border: 1px solid var(--ice-black);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  @media (max-width: 1024px) { .ice-btn { padding: 0 28px; } }
  .ice-btn span { pointer-events: none; }
  .ice-btn-outlined-dark { background: transparent; color: var(--ice-black); border-color: var(--ice-black); }
  .ice-btn-white { background: var(--ice-white); color: var(--ice-black); border-color: var(--ice-white); }
  @media (hover: hover) {
    .ice-btn:hover { background: rgba(38, 38, 38, 0.9); color: var(--ice-white); }
    .ice-btn-outlined-dark:hover { background: var(--ice-black); color: var(--ice-white); }
  }

  .ice-detail-section-title {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;
  }

  /* KEY SPECS */
  .ice-detail-specs { padding: 0 var(--ice-pad); flex-direction: column; display: flex; }
  .ice-specs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--ice-border);
    border: 1px solid var(--ice-border);
    margin-top: 20px;
  }
  @media (max-width: 900px) { .ice-specs-grid { grid-template-columns: repeat(2, 1fr); } }
  .ice-spec-cell { background: var(--ice-white); padding: 26px var(--ice-pad); flex-direction: column; gap: 8px; display: flex; }
  .ice-spec-key {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 1.4;
    color: var(--ice-black);
    opacity: var(--ice-opacity);
  }
  .ice-spec-value { font-family: var(--ice-sans); font-size: 16px; line-height: 1.25; font-weight: 500; }

  /* FULL SPECS */
  .ice-detail-fullspecs, .ice-detail-apps { padding: 0 var(--ice-pad); flex-direction: column; display: flex; }
  .ice-specs-table { border-top: 1px solid var(--ice-border); margin-top: 20px; display: flex; flex-direction: column; }
  .ice-specs-row { padding: 18px 2px; border-bottom: 1px solid var(--ice-border); column-gap: 24px; row-gap: 6px; display: flex; align-items: baseline; }
  .ice-specs-key {
    flex: 0 0 200px;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 1.4;
    opacity: var(--ice-opacity);
  }
  .ice-specs-value { flex: 1; font-family: var(--ice-sans); font-size: 15px; line-height: 1.5; }
  @media (max-width: 620px) { .ice-specs-row { flex-direction: column; gap: 4px; } .ice-specs-key { flex: none; } }

  /* APPLICATIONS */
  .ice-apps-list { margin-top: 24px; flex-flow: wrap; gap: 10px; display: flex; }
  .ice-app-tag {
    padding: 9px 16px;
    border: 1px solid var(--ice-border);
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 11px;
    line-height: 1.4;
  }

  /* ABOUT */
  .ice-detail-about { display: flex; padding: 0 var(--ice-pad); }
  .ice-detail-about-inner {
    width: 100%;
    padding-bottom: 70px;
    border-bottom: 1px solid var(--ice-border);
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    column-gap: 24px;
  }
  @media (max-width: 1024px) { .ice-detail-about-inner { grid-template-columns: 1fr; gap: 18px; padding-bottom: 48px; } }
  .ice-detail-about-label {
    grid-column: 1 / span 12;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    opacity: var(--ice-opacity);
  }
  @media (max-width: 1024px) { .ice-detail-about-label { grid-column: 1; } }
  .ice-detail-about-text {
    grid-column: 4 / span 12;
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 19px;
    line-height: 1.4;
    font-weight: 500;
    margin: 0;
  }
  @media (max-width: 1024px) { .ice-detail-about-text { grid-column: 1; font-size: 17px; } }

  /* RELATED SLIDER */
  .ice-slider-section { scroll-margin-top: calc(52px + 24px); }
  .ice-slider { flex-direction: column; display: flex; }
  .ice-slider-title { padding: 0 var(--ice-pad) 17px; width: 100%; color: var(--ice-black); align-items: center; display: flex; }
  .ice-slider-title h2 { font-family: var(--ice-mono); letter-spacing: 0.01em; text-transform: uppercase; font-size: 12px; line-height: 1.4; font-weight: 400; margin: 0; }
  .ice-slider-title-wrapper { font-family: var(--ice-mono); letter-spacing: 0.01em; text-transform: uppercase; align-items: center; gap: 16px; width: 100%; font-size: 12px; line-height: 1.4; display: flex; }
  .ice-slider-controls { font-family: var(--ice-mono); letter-spacing: -0.01em; gap: 14px; margin-left: auto; font-size: 12px; line-height: 1.4; display: flex; }
  .ice-slider-controls button { font-family: var(--ice-mono); font-size: 12px; line-height: 1.4; letter-spacing: -0.01em; background: none; border: none; padding: 0; color: var(--ice-black); cursor: pointer; text-transform: uppercase; }
  .ice-slider-controls button:disabled { opacity: var(--ice-opacity); pointer-events: none; }
  @media (max-width: 1024px) { .ice-slider-controls { display: none; } .ice-slider-title-wrapper { justify-content: space-between; } }
  .ice-slider-items {
    width: calc(100% + var(--ice-gap));
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-left: calc(var(--ice-gap) * -1);
    overflow-x: scroll;
    scrollbar-width: none;
    --ice-gap: 1px;
    --ice-flex: calc(100% / 1.3);
  }
  @media (min-width: 1024px) { .ice-slider-items { --ice-flex: calc(100% / 5); } }
  .ice-slider-items::-webkit-scrollbar { display: none; }
  .ice-slider-track { display: flex; }
  .ice-slider-item { flex: 0 0 var(--ice-flex); scroll-snap-align: start; scroll-snap-stop: always; min-width: 0; padding-left: var(--ice-gap); position: relative; }

  /* CTA */
  .ice-cta {
    background: #fff;
    color: #1a365d;
    min-height: 100svh;
    justify-content: center;
    padding: 80px var(--ice-pad);
    text-align: center;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    position: relative;
    z-index: 1;
  }
  .ice-cta h2 { font-family: var(--ice-sans); letter-spacing: -0.01em; font-size: 24px; line-height: 1.15; font-weight: 600; margin: 0; max-width: 20ch; }
  .ice-cta p { font-family: var(--ice-sans); font-size: 15px; line-height: 1.5; margin: 0; opacity: 0.8; max-width: 44ch; }
  .ice-cta .ice-btn-white { background: #1a365d; color: var(--ice-white); border-color: #1a365d; }
  @media (hover: hover) {
    .ice-cta .ice-btn-white:hover { background: #1a365d; color: var(--ice-white); border-color: #1a365d; }
  }
  @media (min-width: 1024px) { .ice-cta { gap: 30px; } .ice-cta h2 { letter-spacing: -0.02em; font-size: 64px; line-height: 1.05; } }

  /* Anti-slop: each section reveals as ONE block with a shorter, confident fade
     (the global t--fade is 0.9s; per-item staggering has been removed). */
  html.js [data-view].inview .t--fade.ice-block,
  html.js [data-view].inview .t--fade.ice-detail-info,
  html.js [data-view].inview .t--fade.ice-detail-about-inner {
    animation-duration: 0.55s;
  }
  /* CTA content is now wrapped so the block keeps the centered column layout */
  .ice-cta .ice-block { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  @media (min-width: 1024px) { .ice-cta .ice-block { gap: 30px; } }
</style>