---
interface Props {
  id: string;
  name: string;
  fullName?: string;
  brand: string;
  brandName?: string;
  description: string;
  specs: { key: string; value: string }[];
  applications?: string[];
  image: string;
}

const { id, name, fullName, brand, brandName, description, specs, applications, image } = Astro.props;
---

<a href={`/catalogue/${id}`} class="product-card" data-brand={brand}>
  <div class="product-card-image">
    <img src={image} alt={fullName || name} loading="lazy" />
  </div>
  <div class="product-card-body">
    <div class="product-card-top">
      <h3 class="product-card-title">{name}</h3>
      <span class="product-card-arrow" aria-hidden="true">→</span>
    </div>
    {brandName && <span class="product-card-brand">{brandName}</span>}
    <p class="product-card-desc">{description}</p>
    <div class="product-card-specs">
      {specs.slice(0, 3).map(spec => (
        <div class="spec-row">
          <span class="spec-key">{spec.key}:</span>
          <span class="spec-value">{spec.value}</span>
        </div>
      ))}
    </div>
    {applications && applications.length > 0 && (
      <div class="product-card-apps">
        {applications.slice(0, 3).map(app => (
          <span class="product-card-tag">{app}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .product-card:hover {
    border-color: var(--greige-lightest);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .product-card-image {
    aspect-ratio: 4 / 3;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.25rem;
    transition: transform 0.3s;
  }
  .product-card:hover .product-card-image img {
    transform: scale(1.04);
  }
  .product-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }
  .product-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .product-card-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
    flex: 1;
  }
  .product-card-arrow {
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s, transform 0.15s;
    margin-top: 2px;
  }
  .product-card:hover .product-card-arrow {
    opacity: 0.5;
    transform: translateX(0);
  }
  .product-card-brand {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .product-card-desc {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-card-specs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.25rem;
  }
  .spec-row {
    display: flex;
    gap: 0.4rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .spec-key { color: var(--color-text-muted); white-space: nowrap; }
  .spec-value { color: var(--color-text); font-weight: 600; }
  .product-card-apps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .product-card-tag {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }
</style>
