  .nav-overlay-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.3s var(--ease-soft), transform 0.4s var(--ease-snappy);
  }
  .nav-overlay.open .nav-overlay-label {
    opacity: 1;
    transform: none;
    transition-delay: 0.2s;
  }
  .nav-overlay-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-overlay-list > li {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.3s var(--ease-soft), transform 0.4s var(--ease-snappy);
  }
  .nav-overlay.open .nav-overlay-list > li { opacity: 1; transform: none; }
  .nav-overlay.open .nav-overlay-list > li:nth-child(1) { transition-delay: 0.2s; }
  .nav-overlay.open .nav-overlay-list > li:nth-child(2) { transition-delay: 0.28s; }
  .nav-overlay.open .nav-overlay-list > li:nth-child(3) { transition-delay: 0.36s; }
  .nav-overlay.open .nav-overlay-list > li:nth-child(4) { transition-delay: 0.44s; }
  .nav-overlay.open .nav-overlay-list > li:nth-child(5) { transition-delay: 0.52s; }
  .nav-overlay.open .nav-overlay-list > li:nth-child(6) { transition-delay: 0.6s; }
  .nav-overlay-link {
    display: block;
    padding: 0.9rem 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    color: #fff;
