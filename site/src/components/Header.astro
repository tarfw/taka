  /* ═══ Responsive ═══ */
  @media (max-width: 1280px) {
    .nav-logo { margin-left: 0; }
  }
  @media (max-width: 1024px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .nav-pill, .nav-cta { display: none; }
    .nav-burger { display: flex; }
  }
  @media (max-width: 768px) {
    .nav-inner { padding: 0 1rem; }
    .nav-logo-img { height: 26px; }
  }
</style>

<script>
  // Desktop pill dropdowns
  document.querySelectorAll('.nav-pill-dropdown').forEach(dropdown => {
    const btn = dropdown.querySelector('.nav-pill-link');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = dropdown.classList.contains('open');
      document.querySelectorAll('.nav-pill-dropdown').forEach(d => d.classList.remove('open'));
      if (!wasOpen) dropdown.classList.add('open');
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('.nav-pill-dropdown').forEach(d => d.classList.remove('open'));
  });

  // Mobile accordion
  document.querySelectorAll('.mobile-accordion').forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const wasOpen = btn.classList.contains('open');
      const section = btn.closest('.nav-mobile-section');
      if (section) {
        section.querySelectorAll('.mobile-accordion').forEach(b => b.classList.remove('open'));
        section.querySelectorAll('.mobile-accordion-content').forEach(c => c.classList.remove('open'));
      }
      if (!wasOpen) {
        btn.classList.add('open');
        content.classList.add('open');
      }
    });
  });

  // Mobile menu toggle
  const burger = document.getElementById('mobile-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const headerEl = document.getElementById('navbar');
  if (burger && mobileNav) {
    burger.addEventListener('click', () => {
      const isOpen = mobileNav.classList.contains('open');
      mobileNav.classList.toggle('open');
      burger.setAttribute('data-state', isOpen ? 'closed' : 'open');
      document.body.style.overflow = isOpen ? '' : 'hidden';
      if (headerEl) headerEl.classList.toggle('menu-open', !isOpen);
    });
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        burger.setAttribute('data-state', 'closed');
        document.body.style.overflow = '';
        if (headerEl) headerEl.classList.remove('menu-open');
      });
    });
  }

  // Header transparency on scroll
  const header = document.getElementById('navbar');
  if (header) {
    const toggleHeader = () => {
      if (document.body.hasAttribute('data-header-solid')) {
        header.classList.remove('transparent');
        return;
      }
      if (window.scrollY < 40) {
        header.classList.add('transparent');
      } else {
        header.classList.remove('transparent');
      }
    };
    toggleHeader();
    window.addEventListener('scroll', toggleHeader, { passive: true });
  }
</script>
