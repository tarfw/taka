  .burger-line:nth-child(1) { transform: translateY(-6px); }
  .burger-line:nth-child(2) { transform: translateY(0); }
  .burger-line:nth-child(3) { transform: translateY(6px); }
  .nav-burger[data-state="open"] .burger-line:nth-child(1) { transform: rotate(45deg); }
  .nav-burger[data-state="open"] .burger-line:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav-burger[data-state="open"] .burger-line:nth-child(3) { transform: rotate(-45deg); }

  /* ═══ Fullscreen menu ═══ */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .nav-overlay.open {
    pointer-events: auto;
    opacity: 1;
  }
  .nav-overlay-menu {
    position: relative;
    padding: 100px 2rem 2rem;
