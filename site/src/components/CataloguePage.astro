---
import ProductCardMini from './ProductCardMini.astro';

interface Product {
  id: string;
  name: string;
  fullName?: string;
  brandName?: string;
  subcategoryName?: string;
  image: string;
}

interface GridCard {
  label: string;
  text: string;
  href?: string;
}

interface Section {
  id: string;
  title: string;
  sub: string;
  products?: Product[];
  cards?: GridCard[];
  quote?: boolean;
}

interface Props {
  hero: {
    image: string;
    title: string;
    buttons?: { label: string; href: string }[];
    trust: string[];
  };
  headline: {
    text: string;
    button?: { label: string; href: string };
  };
  categoryCards?: { name: string; image: string; href: string; contain?: boolean }[];
  highlight?: {
    image: string;
    title: string;
    buttons?: { label: string; href: string }[];
  };
  sections?: Section[];
  cta: {
    title: string;
    text: string;
    button?: { label: string; href: string };
  };
}

const { hero, headline, categoryCards = [], highlight, sections = [], cta } = Astro.props;
---

<div class="ice-page">

  <section class="ice-hero hero-container" data-view>
    <div class="ice-hero-image">
      <img src={hero.image} alt="TAKA Scientific" class="ice-hero-img" fetchpriority="high" data-parallax="zoom" />
      <div class="ice-hero-overlay">
        <h1 data-splitting="words">{hero.title}</h1>
        <div class="ice-hero-buttons t--fade t--delay_200">
          {(hero.buttons ?? [{ label: 'Explore the range', href: '#range' }]).map(btn => (
            <a href={btn.href} class="ice-btn ice-btn-outlined"><span>{btn.label}</span></a>
          ))}
        </div>
      </div>
      <div class="ice-hero-trust t--fade t--delay_300">
        {hero.trust.map(item => (
          <p>{item}</p>
        ))}
      </div>
    </div>
  </section>

  {headline.text && (
    <section class="ice-headline-text ice-headline-footer" data-view>
      <div class="ice-headline-wrapper">
        <p class="ice-headline-big t--fadedown">{headline.text}</p>
        {headline.button && <a href={headline.button.href} class="ice-btn t--fade t--delay_300"><span>{headline.button.label}</span></a>}
      </div>
    </section>
  )}

  {categoryCards.length > 0 && (
    <section class="ice-cat-section" id="range" data-view>
      <div class="ice-cat-grid">
        {categoryCards.map((card, i) => (
          <a href={card.href} class="ice-cat-card t--fade t--delay_{(i % 4) * 100 + 100}">
            <span class={'ice-cat-image' + (card.contain ? ' ice-cat-image-contain' : '')}>
              <img src={card.image} alt={card.name} loading="lazy" decoding="async" class={card.contain ? 'ice-cat-img-contain' : undefined} />
            </span>
            <span class="ice-cat-name">
              <span class="ice-cat-name-text">{card.name}</span>
              <span class="ice-cat-arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {highlight && (
    <section class="ice-highlight" data-view>
      <div class="ice-highlight-image clip--top_left">
        <img src={highlight.image} alt={highlight.title} loading="lazy" />
      </div>
      <div class="ice-highlight-overlay">
        <h2 class="t--fadedown">{highlight.title}</h2>
        <div class="ice-hero-buttons t--fade t--delay_300">
          {(highlight.buttons ?? [{ label: 'Explore the range', href: '#range' }, { label: 'Get a quote', href: '/contact' }]).map(btn => (
            <a href={btn.href} class="ice-btn ice-btn-outlined"><span>{btn.label}</span></a>
          ))}
        </div>
      </div>
    </section>
  )}

  {sections.map(section => (
    section.products && section.products.length > 0 ? (
      <section class="ice-slider-section" id={section.id} data-view>
        <div class="ice-slider">
          <div class="ice-slider-title">
            <div class="ice-slider-title-wrapper">
              <h2 class="t--fadedown">{section.title}</h2>
              {section.quote && <a href="/contact" class="t--fade t--delay_200">Get a quote</a>}
            </div>
            <div class="ice-slider-controls">
              <button class="ice-slider-prev" aria-label="Previous" disabled>Prev</button>
              <button class="ice-slider-next" aria-label="Next" disabled>Next</button>
            </div>
          </div>
          <p class="ice-slider-sub t--fade t--delay_300">{section.sub}</p>
          <div class="ice-slider-items">
            <div class="ice-slider-track">
              {section.products.map(p => (
                <div class="ice-slider-item">
                  <ProductCardMini
                    id={p.id}
                    name={p.name}
                    fullName={p.fullName}
                    brandName={p.brandName}
                    subcategoryName={p.subcategoryName}
                    image={p.image}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="ice-grid-section" id={section.id} data-view>
        <div class="ice-grid-head">
          <h2 class="t--fadedown">{section.title}</h2>
        </div>
        <p class="ice-slider-sub t--fade t--delay_200">{section.sub}</p>
        <div class="ice-grid">
          {(section.cards ?? []).map((card, i) => (
            card.href ? (
              <a href={card.href} class="ice-grid-card t--fade t--delay_{(i % 4) * 100 + 100}">
                <span class="ice-grid-label">{card.label}</span>
                <p>{card.text}</p>
              </a>
            ) : (
              <div class="ice-grid-card t--fade t--delay_{(i % 4) * 100 + 100}">
                <span class="ice-grid-label">{card.label}</span>
                <p>{card.text}</p>
              </div>
            )
          ))}
        </div>
      </section>
    )
  ))}

  <section class="ice-cta" data-view>
    <h2 class="t--fadedown">{cta.title}</h2>
    <p class="t--fade t--delay_200">{cta.text}</p>
    <a href={(cta.button ?? { label: 'Talk to our team', href: '/contact' }).href} class="ice-btn ice-btn-white t--fade t--delay_400"><span>{(cta.button ?? { label: 'Talk to our team', href: '/contact' }).label}</span></a>
  </section>

</div>

<script>
  document.querySelectorAll('.ice-slider').forEach(slider => {
    const scroller = slider.querySelector('.ice-slider-items');
    const prev = slider.querySelector('.ice-slider-prev');
    const next = slider.querySelector('.ice-slider-next');
    if (!scroller || !prev || !next) return;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      prev.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= max - 1;
    };
    const step = () => {
      const item = scroller.querySelector('.ice-slider-item');
      return item ? item.offsetWidth : scroller.clientWidth;
    };

    prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', update, { passive: true });
    update();
    window.addEventListener('resize', update);
  });
</script>

<style>
  .ice-page {
    --ice-pad: 24px;
    --ice-black: #262626;
    --ice-white: #ffffff;
    --ice-border: #ececec;
    --ice-image-bg: #ececec;
    --ice-sans: var(--font-sans);
    --ice-mono: var(--font-mono);
    --ice-opacity: 0.35;
    --ice-underline-offset: 0.3em;
    --ice-btn-height: 32px;
    --ice-page-gap: 120px;
    --ice-header-height: 52px;
    background: var(--ice-white);
    color: var(--ice-black);
    font-size: 10px;
    flex-direction: column;
    gap: var(--ice-page-gap);
    display: flex;
  }
  @media (max-width: 1024px) {
    .ice-page { --ice-page-gap: 72px; }
  }

  /* BUTTONS */
  .ice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: var(--ice-black);
    color: var(--ice-white);
    height: var(--ice-btn-height);
    padding: 0 36px;
    border: 1px solid var(--ice-black);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  @media (max-width: 1024px) {
    .ice-btn { padding: 0 28px; }
  }
  .ice-btn span { pointer-events: none; }

  .ice-btn-white {
    background: var(--ice-white);
    color: var(--ice-black);
    border-color: var(--ice-white);
  }

  .ice-btn-outlined {
    background: transparent;
    color: var(--ice-white);
    border-color: rgba(255, 255, 255, 0.5);
    padding: 0 12px;
  }

  .ice-cta .ice-btn-white {
    background: #1a365d;
    color: var(--ice-white);
    border-color: #1a365d;
  }

  .ice-cta .ice-btn-white:hover {
    background: var(--ice-white) !important;
    color: #1a365d !important;
    border-color: #1a365d !important;
  }

  @media (hover: hover) {
    .ice-btn:hover {
      background: rgba(38, 38, 38, 0.9);
      color: var(--ice-white);
      border-color: rgba(38, 38, 38, 0.9);
    }
    .ice-btn-white:hover {
      background: var(--ice-black);
      color: var(--ice-white);
      border-color: var(--ice-black);
    }
    .ice-btn-outlined:hover {
      border-color: var(--ice-white);
      background: transparent;
    }
  }

  /* HERO */
  .ice-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
  }
  .ice-hero-image {
    height: 100svh;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .ice-hero-image:after {
    content: "";
    pointer-events: none;
    background: linear-gradient(#0003 0% 70%, #0003 70%, #0000004d 80%, #0006 100%);
    position: absolute;
    inset: 0;
  }
  .ice-hero-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-hero-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 150px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-hero-overlay h1 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-hero-overlay h1 {
      letter-spacing: -0.02em;
      font-size: 88px;
      line-height: 0.9;
      max-width: 55%;
    }
    .ice-hero-overlay { padding-bottom: 76px; }
  }
  .ice-hero-buttons {
    flex-flow: wrap;
    gap: 12px;
    display: flex;
  }

  /* SLIDER BASE */
  .ice-slider-section {
    padding: 0;
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
  }
  .ice-slider {
    flex-direction: column;
    display: flex;
  }
  .ice-slider-title {
    padding: 0 var(--ice-pad) 14px;
    width: 100%;
    color: var(--ice-black);
    align-items: center;
    display: flex;
  }
  @media (min-width: 1024px) {
    .ice-slider-title { padding: 0 var(--ice-pad) 17px; }
  }
  .ice-slider-title h2 {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;
  }
  .ice-slider-controls {
    font-family: var(--ice-mono);
    letter-spacing: -0.01em;
    gap: 14px;
    margin-left: auto;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-controls button {
    font-family: var(--ice-mono);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    background: none;
    border: none;
    padding: 0;
    color: var(--ice-black);
    cursor: pointer;
    text-transform: uppercase;
  }
  .ice-slider-controls button:disabled {
    opacity: var(--ice-opacity);
    pointer-events: none;
  }
  @media (max-width: 1024px) {
    .ice-slider-title { padding-bottom: 14px; }
    .ice-slider-controls { display: none; }
    .ice-slider-title-wrapper { justify-content: space-between; }
  }
  .ice-slider-title-wrapper {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    align-items: center;
    gap: 16px;
    width: 100%;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-title-wrapper a {
    opacity: var(--ice-opacity);
    text-decoration: none;
    color: inherit;
  }
  @media (hover: hover) {
    .ice-slider-title-wrapper a:hover {
      opacity: 1;
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }
  @media (max-width: 1024px) {
    .ice-slider-title-wrapper a {
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }

  .ice-slider-items {
    width: calc(100% + var(--ice-gap));
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-left: calc(var(--ice-gap) * -1);
    overflow-x: scroll;
    scrollbar-width: none;
  }
  .ice-slider-items::-webkit-scrollbar { display: none; }
  .ice-slider-track {
    display: flex;
  }
  .ice-slider-item {
    flex: 0 0 var(--ice-flex);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-width: 0;
    padding-left: var(--ice-gap);
    position: relative;
  }

  /* Product slider */
  .ice-slider-items {
    --ice-gap: 1px;
    --ice-flex: calc(100% / 1.3);
  }
  @media (min-width: 1024px) {
    .ice-slider-items {
      --ice-flex: calc(100% / 5);
    }
  }

  /* CATEGORIES — Explore the range */
  .ice-cat-section {
    padding: 0 var(--ice-pad);
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
  }
  .ice-cat-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
    display: grid;
  }
  @media (min-width: 768px) {
    .ice-cat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--ice-pad);
    }
  }
  @media (min-width: 1024px) {
    .ice-cat-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--ice-pad);
    }
  }
  .ice-cat-card {
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    display: flex;
  }
  .ice-cat-image {
    aspect-ratio: 4 / 3;
    background: var(--ice-image-bg);
    overflow: hidden;
    display: block;
    position: relative;
  }
  .ice-cat-image img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    display: block;
    padding: 16px;
    background: var(--ice-white);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .ice-cat-card:hover .ice-cat-image img {
      transform: scale(1.05);
    }
  }
  .ice-cat-image-contain {
    background: #fff;
  }
  .ice-cat-image img.ice-cat-img-contain {
    object-fit: contain;
    padding: 20px;
  }
  .ice-cat-name {
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    font-family: var(--ice-sans);
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
    display: flex;
  }
  .ice-cat-name-text {
    text-underline-offset: var(--ice-underline-offset);
    text-decoration-color: transparent;
    transition: text-decoration-color 0.25s ease;
  }
  .ice-cat-arrow {
    font-family: var(--ice-mono);
    font-size: 12px;
    line-height: 1.4;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .ice-cat-card:hover .ice-cat-name-text {
      text-decoration: underline;
      text-decoration-color: currentColor;
    }
    .ice-cat-card:hover .ice-cat-arrow {
      transform: translateX(5px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ice-cat-image img,
    .ice-cat-name-text,
    .ice-cat-arrow {
      transition: none;
    }
  }

  /* HIGHLIGHT — banner */
  .ice-headline-text {
    text-align: center;
    flex-direction: column;
    align-items: center;
    padding: 0;
    display: flex;
  }
  .ice-headline-footer {
    color: #1a365d;
  }
  .ice-headline-footer .ice-btn {
    background: #1a365d;
    border-color: #1a365d;
  }
  @media (min-width: 1024px) {
    .ice-headline-text {
      gap: var(--ice-pad);
      padding: 0 var(--ice-pad);
      display: grid;
      grid-template-columns: repeat(16, 1fr);
    }
  }
  .ice-headline-wrapper {
    text-align: center;
    max-width: 750px;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
  }
  @media (min-width: 1024px) {
    .ice-headline-wrapper {
      grid-column: 5 / span 8;
      gap: 30px;
    }
  }
  .ice-headline-big {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-headline-big {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  .ice-highlight {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .ice-highlight-image {
    aspect-ratio: 2;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  @media (max-width: 1024px) {
    .ice-highlight-image {
      height: calc(100svh - var(--ice-header-height));
      aspect-ratio: auto;
    }
  }
  .ice-highlight-image:after {
    content: "";
    pointer-events: none;
    background:
      linear-gradient(180deg, #00000099 0%, #0000004d 40%, #00000059 60%, #000000e6 100%),
      linear-gradient(90deg, #1a365d99 0%, #1a365d33 45%, #00000000 70%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.18'/%3E%3C/svg%3E");
    position: absolute;
    inset: 0;
  }
  .ice-highlight-image img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-highlight-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 56px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-highlight-overlay p {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin-bottom: 15px;
    font-size: 12px;
    line-height: 1.4;
  }
  .ice-highlight-overlay h2 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-highlight-overlay h2 {
      letter-spacing: -0.01em;
      font-size: 56px;
      line-height: 1.05;
      max-width: 65%;
    }
  }

  /* HERO TRUST OVERLAY */
  .ice-hero-trust {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 14px var(--ice-pad);
    flex-flow: wrap;
    gap: 8px 48px;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
    background: linear-gradient(#0000, #0009 100%);
  }
  .ice-hero-trust p {
    margin: 0;
    opacity: 0.8;
    color: var(--ice-white);
    position: relative;
  }
  .ice-hero-trust p + p:before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ice-white);
    opacity: 0.45;
    position: absolute;
    left: -24px;
    top: 50%;
    transform: translateY(-50%);
  }
  @media (max-width: 480px) {
    .ice-page { --ice-pad: 16px; }
    .ice-hero-overlay h1 { font-size: 34px; }
    .ice-hero-overlay { padding-bottom: 96px; }
    .ice-hero-trust { gap: 6px 20px; }
    .ice-hero-trust p + p:before { left: -10px; }
    .ice-highlight-overlay h2 { font-size: 32px; }
    .ice-slider-title-wrapper { gap: 12px; }
  }

  /* SLIDER SUBTITLE */
  .ice-slider-sub {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    font-size: 12px;
    line-height: 1.5;
    margin: 0;
    padding: 0 var(--ice-pad) 20px;
    opacity: 0.65;
    max-width: 62ch;
  }

  /* GRID SECTIONS — content cards */
  .ice-grid-section {
    padding: 0 var(--ice-pad);
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
  }
  .ice-grid-head {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    padding-bottom: 17px;
    font-size: 12px;
    line-height: 1.4;
  }
  .ice-grid-head h2 {
    font-size: inherit;
    font-weight: 400;
