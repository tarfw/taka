---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About TAKA Scientific | Scientific Equipment Supplier in the UAE"
  description="TAKA Scientific supplies scientific equipment, laboratory furniture, testing apparatus, and industrial equipment to the oil and gas sector, research institutions, universities, private companies, government entities, schools, and hospitals across the UAE."
  hasHero={true}
  headerSolid={true}
>
  <section class="page-hero" data-view>
    <div class="container">
      <span class="eyebrow t--fade">About TAKA Scientific</span>
      <h1 class="page-hero-title" data-splitting="words">The trusted equipment partner for labs &amp; facilities in the UAE.</h1>
      <p class="page-hero-sub t--fade t--delay_200">
        Based in Abu Dhabi, we help organisations across the country select, install,
        and maintain the scientific and industrial equipment their operations depend on.
      </p>
    </div>
  </section>

  <section class="section" data-view>
    <div class="container">
      <div class="about-grid">
        <div class="about-left">
          <h2 class="section-title t--fadedown">Who we are.</h2>
        </div>
        <div class="about-right t--fade t--delay_200">
          <p class="about-text">
            TAKA Scientific is an Abu Dhabi-based supplier of scientific equipment,
            laboratory furniture, testing apparatus, and factory machinery. We guide
            organisations from equipment selection through procurement to installation
            and ongoing after-sales support.
          </p>
          <p class="about-text">
            Our clients include the oil and gas sector, research institutions,
            universities, private companies, government entities, schools, and hospitals
            across all seven emirates — Abu Dhabi, Dubai, Sharjah, Ajman, Umm Al-Quwain,
            Ras Al Khaimah, and Fujairah.
          </p>
          <p class="about-text">
            Every project begins by understanding your specific requirements, budget,
            and compliance standards. We then source equipment from trusted manufacturers
            and deliver a solution that performs — and lasts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider container"></div>

  <section class="section" data-view>
    <div class="container">
      <div class="values-grid">
        <div class="value-card t--fade t--delay_100">
          <span class="value-number">01</span>
          <h3 class="value-title">Quality first</h3>
          <p class="value-desc">We work only with trusted manufacturers and verify that every product meets the relevant industry standards.</p>
        </div>
        <div class="value-card t--fade t--delay_250">
          <span class="value-number">02</span>
          <h3 class="value-title">Complete service</h3>
          <p class="value-desc">From first consultation to final installation, we handle every step of the process so you can stay focused on your work.</p>
        </div>
        <div class="value-card t--fade t--delay_400">
          <span class="value-number">03</span>
          <h3 class="value-title">Local expertise</h3>
          <p class="value-desc">Deep knowledge of UAE regulations, standards, and institutional requirements across all seven emirates.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ice-cta" data-view>
    <h2 class="t--fadedown">Get in touch.</h2>
    <p class="t--fade t--delay_200">Browse our catalog or contact us directly.</p>
    <a href="/contact" class="ice-btn ice-btn-white t--fade t--delay_400"><span>Contact</span></a>
  </section>
</Layout>

<style>
  .page-hero {
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    background: #fff;
    position: relative;
  }
  .page-hero .container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: 3.5rem;
  }
  .page-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .page-hero-sub {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }
  .about-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .about-text:last-child { margin-bottom: 0; }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .value-card {
    background: #fff;
    padding: 2rem 1.5rem;
  }
  .value-number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 1rem;
  }
  .value-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .value-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  @media (max-width: 768px) {
    .page-hero .container { padding-bottom: 2.5rem; }
    .page-hero-title { font-size: 2rem; }
    .about-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .values-grid { grid-template-columns: 1fr; }
  }
/* ═══ CONTACT CTA — ice-cta design (matches analytical) ═══ */
  .ice-cta {
    --ice-pad: 24px;
    background: #fff;
    color: #1a365d;
    min-height: 100svh;
    justify-content: center;
    padding: 80px var(--ice-pad);
    text-align: center;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    position: relative;
    z-index: 1;
  }
  .ice-cta h2 {
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
    max-width: 20ch;
  }
  .ice-cta p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
    max-width: 44ch;
  }
  .ice-cta .ice-btn,
  .ice-cta .ice-btn:hover {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    height: 32px;
    padding: 0 36px;
    border: 1px solid #1a365d;
    background: #1a365d;
    color: #ffffff;
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  .ice-cta .ice-btn:hover {
    background: #ffffff;
    color: #1a365d;
  }
  .ice-cta .ice-btn span { pointer-events: none; }
  @media (min-width: 1024px) {
    .ice-cta { gap: 30px; }
    .ice-cta h2 {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }
  @media (max-width: 480px) {
    .ice-cta { --ice-pad: 16px; }
  }
</style>
