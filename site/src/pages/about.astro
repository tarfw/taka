---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About TAKA</span>
      <h1 class="page-hero-title">Equipping facilities<br>across the UAE.</h1>
      <p class="page-hero-sub">
        We supply schools, hospitals, laboratories and factories with the furniture
        and equipment they need to operate efficiently.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-left">
          <h2 class="section-title">Who we are.</h2>
        </div>
        <div class="about-right">
          <p class="about-text">
            TAKA Scientific is a retail supplier of scientific equipment, laboratory furniture,
            testing apparatus, and factory equipment based in Abu Dhabi, UAE.
          </p>
          <p class="about-text">
            We serve schools, hospitals, research institutions, and manufacturing facilities
            across all seven emirates. Our product range covers everything from classroom
            desks to specialized laboratory fume hoods.
          </p>
          <p class="about-text">
            Our team helps clients select the right equipment for their specific requirements,
            budget, and compliance standards. We handle delivery, installation, and ongoing support.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider container"></div>

  <section class="section">
    <div class="container">
      <div class="values-grid">
        <div class="value-card">
          <span class="value-number">01</span>
          <h3 class="value-title">Quality first</h3>
          <p class="value-desc">We source equipment from trusted manufacturers and ensure every product meets industry standards.</p>
        </div>
        <div class="value-card">
          <span class="value-number">02</span>
          <h3 class="value-title">Complete service</h3>
          <p class="value-desc">From selection to installation — we handle the entire process so you can focus on your work.</p>
        </div>
        <div class="value-card">
          <span class="value-number">03</span>
          <h3 class="value-title">Local expertise</h3>
          <p class="value-desc">Based in Abu Dhabi with deep knowledge of UAE regulations, standards, and institutional needs.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container text-center">
      <h2 class="section-title">Get in touch.</h2>
      <p class="section-subtitle" style="margin-left: auto; margin-right: auto;">Browse our catalog or contact us directly.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem;">
        <a href="/products" class="btn btn-dark">Products</a>
        <a href="/contact" class="btn btn-outline">Contact</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .page-hero-sub {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }
  .about-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .about-text:last-child { margin-bottom: 0; }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .value-card {
    background: #fff;
    padding: 2rem 1.5rem;
  }
  .value-number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 1rem;
  }
  .value-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .value-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  @media (max-width: 768px) {
    .page-hero { padding: 3.5rem 0 2.5rem; }
    .page-hero-title { font-size: 2rem; }
    .about-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
