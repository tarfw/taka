---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductFilters from '../components/ProductFilters.astro';
import productData from '../data/products.json';

const allProducts = productData.categories.flatMap(cat => 
  cat.brands.flatMap(brand => 
    brand.subcategories.flatMap(sc => 
      sc.products.map(p => ({
        ...p,
        categoryName: cat.name,
        brandName: brand.name,
        subcategoryName: sc.name
      }))
    )
  )
);

const totalProducts = allProducts.length;

const categories = productData.categories.map(c => ({
  id: c.id,
  name: c.name,
  shortName: c.shortName,
}));

const tabConfig = productData.categories.map(c => ({
  id: c.id,
  name: c.name,
  description: c.description || '',
}));

const subcategoryCategoryMap = new Map<string, { id: string; name: string; count: number; categoryId: string }>();
productData.categories.forEach(cat => {
  cat.brands.forEach(brand => {
    brand.subcategories.forEach(sc => {
      const key = sc.id + '|' + cat.id;
      if (subcategoryCategoryMap.has(key)) {
        subcategoryCategoryMap.get(key)!.count += sc.products.length;
      } else {
        subcategoryCategoryMap.set(key, {
          id: sc.id,
          name: sc.name,
          count: sc.products.length,
          categoryId: cat.id
        });
      }
    });
  });
});
const subcategories = Array.from(subcategoryCategoryMap.values());

const brandCategoryMap = new Map<string, { id: string; name: string; logo?: string; count: number; categoryId: string }>();
productData.categories.forEach(cat => {
  cat.brands.forEach(b => {
    const key = b.id + '|' + cat.id;
    if (brandCategoryMap.has(key)) {
      brandCategoryMap.get(key)!.count += b.subcategories.reduce((sum, sc) => sum + sc.products.length, 0);
    } else {
      brandCategoryMap.set(key, {
        id: b.id,
        name: b.name,
        logo: b.logo,
        count: b.subcategories.reduce((sum, sc) => sum + sc.products.length, 0),
        categoryId: cat.id
      });
    }
  });
});
const brands = Array.from(brandCategoryMap.values());
---

<Layout title="Catalogue — TAKA Scientific" headerSolid={true}>
  <section class="page-hero">
    <div class="container">
      <div class="hero-toolbar">
        <div class="search-field">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="productSearch" class="search-input" placeholder="Search products..." aria-label="Search products" />
          <span class="search-results-count" id="searchResultsCount"></span>
        </div>
      </div>

      <div class="ae-tabs-wrap">
        <button class="ae-scroll-btn ae-scroll-left" aria-label="Scroll tabs left">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="10 3 5 8 10 13"/></svg>
        </button>
        <nav class="ae-tabs" role="tablist">
          {tabConfig.map((tab, i) => (
            <button
              class={`ae-tab${i === 0 ? ' active' : ''}`}
              data-tab={tab.id}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >{tab.name}</button>
          ))}
        </nav>
        <button class="ae-scroll-btn ae-scroll-right" aria-label="Scroll tabs right">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 3 11 8 6 13"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section class="section products-section">
    <div class="container">
      <div class="products-layout">
        <ProductFilters subcategories={subcategories} brands={brands} />
        
        <div class="products-main">
          <div class="products-grid" id="productsGrid">
            {allProducts.map(product => (
              <div 
                class="product-card-wrap"
                data-category={product.category}
                data-brand={product.brand}
                data-subcategory={product.subcategory}
                data-search={`${product.name} ${product.fullName || ''} ${product.description} ${product.categoryName} ${product.brandName} ${product.subcategoryName} ${(product.applications || []).join(' ')}`.toLowerCase()}
              >
                <ProductCard
                  id={product.id}
                  name={product.name}
                  fullName={product.fullName}
                  brand={product.brand}
                  brandName={product.brandName}
                  description={product.description}
                  specs={product.specs}
                  applications={product.applications}
                  image={product.image}
                />
              </div>
            ))}
          </div>

          <div class="products-empty" id="productsEmpty">
            <p>No products match your filters.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container text-center">
      <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: 1.25rem;">Need a quote? Tell us about your facility and requirements.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/916384771990" target="_blank" class="btn btn-outline">WhatsApp</a>
        <a href="/contact" class="btn btn-outline">Contact form</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero .container,
  .products-section .container {
    max-width: 1600px;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .page-hero {
    padding: 2rem 0 1rem;
  }
  .hero-toolbar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 0;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .search-field svg { color: var(--color-text-muted); flex-shrink: 0; }
  .search-input {
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text);
    background: transparent;
    width: 200px;
    transition: width 0.15s;
  }
  .search-input:focus { width: 280px; }
  .search-input::placeholder { color: var(--color-text-muted); }
  .search-results-count {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .search-results-count:empty { display: none; }

  /* ═══ TABS ═══ */
  .ae-tabs-wrap {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    position: relative;
  }
  .ae-tabs {
    display: flex;
    gap: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
  }
  .ae-tabs::-webkit-scrollbar {
    display: none;
  }
  .ae-scroll-btn {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 1;
  }
  .ae-tabs-wrap:hover .ae-scroll-btn {
    opacity: 1;
  }
  .ae-scroll-btn:hover {
    color: var(--color-text);
  }
  .ae-scroll-left {
    margin-right: 0.5rem;
  }
  .ae-scroll-right {
    margin-left: 0.5rem;
  }
  .ae-tab {
    flex-shrink: 0;
    padding: 0.9rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s;
    white-space: nowrap;
    margin-bottom: -1px;
  }
  .ae-tab:hover {
    color: var(--color-text);
  }
  .ae-tab.active {
    color: #fff;
    font-weight: 600;
    background: #044ab3;
  }

  .products-section {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .products-layout {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .products-main {
    flex: 1;
    min-width: 0;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .product-card-wrap {
    display: contents;
  }
  .product-card-wrap.hidden {
    display: none !important;
  }

  .products-empty {
    display: none;
    text-align: center;
    padding: 4rem 0;
  }
  .products-empty.visible {
    display: block;
  }
  .products-empty p {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1200px) {
    .products-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 992px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .page-hero { padding: 2.5rem 0 0; }
    .page-hero-title { font-size: 1.6rem; }
    .hero-toolbar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .search-input { width: 100%; }
    .search-input:focus { width: 100%; }
    .products-layout { flex-direction: column; gap: 1.5rem; }
  }
  @media (max-width: 400px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('productSearch') as HTMLInputElement;
    const grid = document.getElementById('productsGrid');
    const count = document.getElementById('searchResultsCount');
    const productsCount = document.getElementById('productsCount');
    const empty = document.getElementById('productsEmpty');
    const wraps = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.product-card-wrap')) : [];
    const tabsNav = document.querySelector('.ae-tabs');
    
    let selectedCategory = 'analytical-equipments';
    let selectedSubcategory = 'all';
    let selectedBrand = 'all';
    let timer: ReturnType<typeof setTimeout>;

    function syncSidebarFilters() {
      const subcatFilters = document.getElementById('subcategoryFilters');
      const brandFilters = document.getElementById('brandFilters');
      const showForCat = (el: Element) => {
        const itemCat = el.getAttribute('data-category');
        (el as HTMLElement).style.display = itemCat === selectedCategory ? '' : 'none';
      };
      if (subcatFilters) {
        subcatFilters.querySelectorAll('.filter-sidebar-item').forEach(b => {
          b.classList.remove('active');
          showForCat(b);
        });
        subcatFilters.querySelector('[data-subcategory="all"]')?.classList.add('active');
      }
      if (brandFilters) {
        brandFilters.querySelectorAll('.filter-sidebar-item').forEach(b => {
          b.classList.remove('active');
          showForCat(b);
        });
        brandFilters.querySelector('[data-brand="all"]')?.classList.add('active');
      }
    }

    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category');
    if (initialCategory && initialCategory !== 'all') {
      selectedCategory = initialCategory;
      const btn = tabsNav?.querySelector(`[data-tab="${initialCategory}"]`);
      if (btn) {
        tabsNav?.querySelectorAll('.ae-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
    }
    syncSidebarFilters();
    apply();

    function apply() {
      const q = searchInput.value.toLowerCase().trim();
      let n = 0;

      wraps.forEach(w => {
        const catMatch = selectedCategory === 'all' || w.dataset.category === selectedCategory;
        const subcatMatch = selectedSubcategory === 'all' || w.dataset.subcategory === selectedSubcategory;
        const brandMatch = selectedBrand === 'all' || w.dataset.brand === selectedBrand;
        const searchMatch = !q || (w.dataset.search || '').includes(q);
        const visible = catMatch && subcatMatch && brandMatch && searchMatch;
        w.classList.toggle('hidden', !visible);
        if (visible) n++;
      });

      if (count) count.textContent = '';
      if (empty) empty.classList.toggle('visible', n === 0);
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(apply, 120);
      });
    }

    if (tabsNav) {
      tabsNav.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.ae-tab');
        if (!btn) return;
        
        tabsNav.querySelectorAll('.ae-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        selectedCategory = btn.dataset.tab || 'all';
        selectedSubcategory = 'all';
        selectedBrand = 'all';

        syncSidebarFilters();
        apply();
      });
    }

    window.addEventListener('subcategory-change', ((e: CustomEvent) => {
      selectedSubcategory = e.detail.subcategory;
      apply();
    }) as EventListener);

    window.addEventListener('brand-change', ((e: CustomEvent) => {
      selectedBrand = e.detail.brand;
      apply();
    }) as EventListener);

    const scrollLeft = document.querySelector('.ae-scroll-left');
    const scrollRight = document.querySelector('.ae-scroll-right');
    if (scrollLeft && tabsNav) {
      scrollLeft.addEventListener('click', () => {
        tabsNav.scrollBy({ left: -200, behavior: 'smooth' });
      });
    }
    if (scrollRight && tabsNav) {
      scrollRight.addEventListener('click', () => {
        tabsNav.scrollBy({ left: 200, behavior: 'smooth' });
      });
    }
  });
</script>
