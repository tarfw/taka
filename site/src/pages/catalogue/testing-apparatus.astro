---
import Layout from '../../layouts/Layout.astro';
import ProductCardMini from '../../components/ProductCardMini.astro';
import productData from '../../data/products.json';

const category = productData.categories.find(c => c.id === 'testing-apparatus');
if (!category) throw new Error('Category not found');

const subcategories = category.brands.flatMap(brand =>
  brand.subcategories.map(sc => ({
    id: sc.id,
    name: sc.name,
    brandId: brand.id,
    brandName: brand.name,
    products: sc.products.map(p => ({
      ...p,
      brandName: brand.name,
      subcategoryName: sc.name,
      categoryName: category.name
    }))
  }))
);

const productsIn = (ids) =>
  subcategories.filter(sc => ids.includes(sc.id)).flatMap(sc => sc.products);

const productSections = [
  {
    id: 'spectrophotometry',
    title: 'Spectrophotometry & colorimetry',
    sub: 'UV-VIS and visible spectrophotometers, turbidimeters and colorimeters for laboratory and field.',
    products: productsIn(['spectrophotometers', 'colorimeters', 'turbidimeters']),
  },
  {
    id: 'electrochemistry',
    title: 'pH & electrochemistry',
    sub: 'pH meters, benchtop and portable meters, electrochemical probes and electrodes.',
    products: productsIn(['ph-meters', 'benchtop-meters', 'electrochemical-probes', 'electrochemistry']),
  },
  {
    id: 'oxygen',
    title: 'Dissolved oxygen & field testing',
    sub: 'Luminescent dissolved oxygen meters and handheld field instruments for accurate on-site data.',
    products: productsIn(['dissolved-oxygen', 'field-chem', 'field-testing']),
  },
  {
    id: 'titration',
    title: 'Titration & wet chemistry',
    sub: 'Titrators and automated wet chemical analyzers.',
    products: productsIn(['titrators', 'automated-analyzers']),
  },
  {
    id: 'process',
    title: 'Process analysis & online instruments',
    sub: 'Online colorimetric analyzers, TOC analyzers and process controllers.',
    products: productsIn(['process-analyzers', 'toc-analyzers', 'controllers']),
  },
  {
    id: 'sampling',
    title: 'Water samplers',
    sub: 'Portable and refrigerated samplers for collecting representative water samples.',
    products: productsIn(['samplers']),
  },
  {
    id: 'temperature',
    title: 'Temperature control & vacuum ovens',
    sub: 'TOPTION heater/chillers and vacuum drying ovens for material and environmental testing.',
    products: productsIn(['temperature-control', 'vacuum-ovens']),
  },
];

const categoryCards = [
  { name: 'Spectrophotometers', image: '/products/hach/dr3900.jpg', href: '#spectrophotometry' },
  { name: 'pH & Electrochemistry', image: '/products/hach/hq440d.jpg', href: '#electrochemistry' },
  { name: 'Turbidimeters', image: '/products/hach/2100q.jpg', href: '#spectrophotometry' },
  { name: 'Titrators', image: '/products/hach/titrator.jpg', href: '#titration' },
  { name: 'Process Analyzers', image: '/products/hach/dr6000.jpg', href: '#process' },
  { name: 'TOC Analyzers', image: '/products/hach/toc.jpg', href: '#process' },
  { name: 'Temperature Control', image: '/products/toption/heater-chiller.jpg', href: '#temperature' },
];
---

<Layout
  title="Testing Apparatus — Water Quality & Lab Instruments"
  hasHero={true}
  description="Testing apparatus from TAKA Scientific — HACH spectrophotometers, pH meters, turbidimeters, titrators, process analyzers and TOPTION temperature control. Authorized HACH distributor."
>

<div class="ice-page">

  <!-- ——— HERO ——— -->
  <section class="ice-hero hero-container" data-view>
    <div class="ice-hero-image">
      <video class="ice-hero-img" src="/hero3.mp4" autoplay muted loop playsinline fetchpriority="high" aria-hidden="true"></video>
      <div class="ice-hero-overlay">
        <h1>Testing apparatus that proves it</h1>
        <div class="ice-hero-buttons">
          <a href="#range" class="ice-btn ice-btn-outlined"><span>Browse Apparatus</span></a>
        </div>
      </div>
      <div class="ice-hero-trust">
        <p>Authorized distributor &amp; service</p>
        <p>EPA, ASTM &amp; ISO methods</p>
        <p>Portable &amp; lab ready</p>
        <p>On-site delivery &amp; UAE support</p>
      </div>
    </div>
  </section>

  <!-- ===== HEADLINE TEXT ===== -->
  <section class="ice-headline-text ice-headline-footer" data-view>
    <div class="ice-headline-wrapper">
      <p class="ice-headline-big">Precision water quality testing, spectrophotometry, titrators, and turbidity analysis for industrial facilities.</p>
    </div>
  </section>

  <!-- ===== CATEGORIES ——— -->
  <section class="ice-cat-section" id="range" data-view>
    <div class="ice-cat-head">
      <span class="ice-cat-overline">Testing Categories</span>
      <h2 class="ice-cat-title">Find your instrument</h2>
    </div>
    <div class="ice-cat-grid">
      {categoryCards.map((card) => (
        <a href={card.href} class="ice-cat-card">
          <span class={'ice-cat-media' + (card.contain ? ' ice-cat-media-contain' : '')}>
            <img src={card.image} alt={card.name} loading="lazy" decoding="async" class={card.contain ? 'ice-cat-img-contain' : undefined} />
          </span>
          <span class="ice-cat-meta">
            <span class="ice-cat-name">{card.name}</span>
            <span class="ice-cat-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ===== HIGHLIGHT ===== -->
  <section class="ice-highlight" data-view>
    <div class="ice-highlight-image clip--top_left">
      <img src="/testbg2.png" alt="Testing apparatus laboratory" loading="lazy" />
    </div>
    <div class="ice-highlight-overlay">
      <h2>Complete Testing Apparatus Range</h2>
      <div class="ice-hero-buttons">
        <a href="#spectrophotometry" class="ice-btn ice-btn-outlined"><span>View All Apparatus</span></a>
        <a href="/contact" class="ice-btn ice-btn-outlined"><span>Request Technical Quote</span></a>
      </div>
    </div>
  </section>

  <!-- ===== PRODUCT SECTIONS ===== -->
  {productSections.map(section => (
    <section class="ice-slider-section" id={section.id} data-view>
      <div class="ice-slider">
        <div class="ice-slider-title">
          <div class="ice-slider-title-wrapper">
            <h2>{section.title}</h2>
          </div>
          <div class="ice-slider-controls">
            <button class="ice-slider-prev" aria-label="Previous" disabled>Prev</button>
            <button class="ice-slider-next" aria-label="Next" disabled>Next</button>
          </div>
        </div>
        <p class="ice-slider-sub">{section.sub}</p>
        <div class="ice-slider-items">
          <div class="ice-slider-track">
            {section.products.map(p => (
              <div class="ice-slider-item">
                <ProductCardMini
                  id={p.id}
                  name={p.name}
                  fullName={p.fullName}
                  brandName={p.brandName}
                  subcategoryName={p.subcategoryName}
                  image={p.image}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ===== CONTACT CTA ===== -->
  <section class="ice-cta" data-view>
    <h2>Ready to measure with confidence?</h2>
    <p>Tell us about your water quality and testing requirements and we&rsquo;ll recommend the right instruments.</p>
    <a href="/contact" class="ice-btn ice-btn-white"><span>Talk to our team</span></a>
  </section>

</div>

</Layout>

<script>
  document.querySelectorAll('.ice-slider').forEach(slider => {
    const scroller = slider.querySelector('.ice-slider-items');
    const prev = slider.querySelector('.ice-slider-prev');
    const next = slider.querySelector('.ice-slider-next');
    if (!scroller || !prev || !next) return;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      prev.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= max - 1;
    };
    const step = () => {
      const item = scroller.querySelector('.ice-slider-item');
      return item ? item.offsetWidth : scroller.clientWidth;
    };

    prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', update, { passive: true });
    update();
    window.addEventListener('resize', update);
  });
</script>

<style>
  .ice-page {
    --ice-pad: 24px;
    --ice-black: #262626;
    --ice-white: #ffffff;
    --ice-border: #ececec;
    --ice-image-bg: #ececec;
    --ice-sans: var(--font-sans);
    --ice-mono: var(--font-mono);
    --ice-opacity: 0.35;
    --ice-underline-offset: 0.3em;
    --ice-btn-height: 32px;
    --ice-page-gap: 120px;
    --ice-header-height: 52px;
    background: var(--ice-white);
    color: var(--ice-black);
    font-size: 10px;
    flex-direction: column;
    gap: var(--ice-page-gap);
    display: flex;
  }
  @media (max-width: 1024px) {
    .ice-page { --ice-page-gap: 72px; }
  }

  /* ===== BUTTONS ===== */
  .ice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: var(--ice-black);
    color: var(--ice-white);
    height: var(--ice-btn-height);
    padding: 0 36px;
    border: 1px solid var(--ice-black);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  @media (max-width: 1024px) {
    .ice-btn { padding: 0 28px; }
  }
  .ice-btn span { pointer-events: none; }

  .ice-btn-white {
    background: var(--ice-white);
    color: var(--ice-black);
    border-color: var(--ice-white);
  }

  .ice-btn-outlined {
    background: transparent;
    color: var(--ice-white);
    border-color: rgba(255, 255, 255, 0.5);
    padding: 0 12px;
  }

  .ice-cta .ice-btn-white {
    background: #1a365d;
    color: var(--ice-white);
    border-color: #1a365d;
  }

  .ice-cta .ice-btn-white:hover {
    background: var(--ice-white) !important;
    color: #1a365d !important;
    border-color: #1a365d !important;
  }

  @media (hover: hover) {
    .ice-btn:hover {
      background: rgba(38, 38, 38, 0.9);
      color: var(--ice-white);
      border-color: rgba(38, 38, 38, 0.9);
    }
    .ice-btn-white:hover {
      background: var(--ice-black);
      color: var(--ice-white);
      border-color: var(--ice-black);
    }
    .ice-btn-outlined:hover {
      border-color: var(--ice-white);
      background: transparent;
    }
  }

  /* ===== HERO ————— */
  .ice-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
  }
  .ice-hero-image {
    height: 100svh;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .ice-hero-image:after {
    content: "";
    pointer-events: none;
    background: linear-gradient(#0003 0% 70%, #0003 70%, #0000 80%, #0006 100%);
    position: absolute;
    inset: 0;
  }
  .ice-hero-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-hero-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 150px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-hero-overlay h1 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-hero-overlay h1 {
      letter-spacing: -0.02em;
      font-size: 88px;
      line-height: 0.9;
      max-width: 55%;
    }
    .ice-hero-overlay { padding-bottom: 76px; }
  }
  .ice-hero-buttons {
    flex-flow: wrap;
    gap: 12px;
    display: flex;
  }

  /* ===== SLIDER BASE ===== */
  .ice-slider-section {
    padding: 0;
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
  }
  .ice-slider {
    flex-direction: column;
    display: flex;
  }
  .ice-slider-title {
    padding: 0 var(--ice-pad) 14px;
    width: 100%;
    color: var(--ice-black);
    align-items: center;
    display: flex;
  }
  @media (min-width: 1024px) {
    .ice-slider-title { padding: 0 var(--ice-pad) 17px; }
  }
  .ice-slider-title h2 {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;
  }
  .ice-slider-controls {
    font-family: var(--ice-mono);
    letter-spacing: -0.01em;
    gap: 14px;
    margin-left: auto;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-controls button {
    font-family: var(--ice-mono);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    background: none;
    border: none;
    padding: 0;
    color: var(--ice-black);
    cursor: pointer;
    text-transform: uppercase;
  }
  .ice-slider-controls button:disabled {
    opacity: var(--ice-opacity);
    pointer-events: none;
  }
  @media (max-width: 1024px) {
    .ice-slider-title { padding-bottom: 14px; }
    .ice-slider-controls { display: none; }
    .ice-slider-title-wrapper { justify-content: space-between; }
  }
  .ice-slider-title-wrapper {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    align-items: center;
    gap: 16px;
    width: 100%;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-title-wrapper a {
    opacity: var(--ice-opacity);
    text-decoration: none;
    color: inherit;
  }
  @media (hover: hover) {
    .ice-slider-title-wrapper a:hover {
      opacity: 1;
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }
  @media (max-width: 1024px) {
    .ice-slider-title-wrapper a {
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }

  .ice-slider-items {
    width: calc(100% + var(--ice-gap));
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-left: calc(var(--ice-gap) * -1);
    overflow-x: scroll;
    scrollbar-width: none;
  }
  .ice-slider-items::-webkit-scrollbar { display: none; }
  .ice-slider-track {
    display: flex;
  }
  .ice-slider-item {
    flex: 0 0 var(--ice-flex);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-width: 0;
    padding-left: var(--ice-gap);
    position: relative;
  }

  /* Product slider */
  .ice-slider-items {
    --ice-gap: 1px;
    --ice-flex: calc(100% / 1.3);
  }
  @media (min-width: 1024px) {
    .ice-slider-items {
      --ice-flex: calc(100% / 5);
    }
  }

  /* ===== CATEGORIES ===== */
  .ice-cat-section {
    padding: 0 var(--ice-pad);
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
    border-top: 1px solid var(--ice-border);
    padding-top: 24px;
  }
  .ice-cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    margin-bottom: 28px;
  }
  .ice-cat-overline {
    font-family: var(--ice-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(38, 38, 38, 0.55);
  }
  .ice-cat-title {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 500;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-cat-title {
      font-size: 24px;
    }
  }
  .ice-cat-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    display: grid;
  }
  @media (min-width: 768px) {
    .ice-cat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 1024px) {
    .ice-cat-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--ice-pad);
    }
  }
  .ice-cat-card {
    flex-direction: column;
    text-decoration: none !important;
    color: inherit;
    background: var(--ice-white);
    border: 1px solid var(--ice-border);
    border-radius: var(--radius-sm);
    min-width: 0;
    display: flex;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .ice-cat-media {
    aspect-ratio: 4 / 3;
    background: var(--ice-image-bg);
    overflow: hidden;
    display: block;
    position: relative;
  }
  .ice-cat-media img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    display: block;
    padding: 16px;
    background: var(--ice-white);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ice-cat-media-contain {
    background: #fff;
  }
  .ice-cat-media img.ice-cat-img-contain {
    object-fit: contain;
    padding: 24px;
  }
  .ice-cat-meta {
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 16px 18px;
    display: flex;
    background: var(--ice-white);
  }
  .ice-cat-name {
    font-family: var(--ice-sans);
    font-size: 13.5px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--ice-black);
    text-decoration: none !important;
    transition: color 0.2s ease;
  }
  .ice-cat-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  .ice-cat-arrow svg {
    width: 16px;
    height: 16px;
  }
  @media (hover: hover) {
    .ice-cat-card:hover {
      border-color: #cbd5e1 !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.06);
      text-decoration: none !important;
    }
    .ice-cat-card:hover .ice-cat-media img {
      transform: scale(1.03);
    }
    .ice-cat-card:hover .ice-cat-name {
      color: #1a365d !important;
      text-decoration: none !important;
    }
    .ice-cat-card:hover .ice-cat-arrow {
      color: #1a365d !important;
      transform: translateX(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ice-cat-card,
    .ice-cat-media img,
    .ice-cat-name,
    .ice-cat-arrow {
      transition: none;
    }
  }

  /* ===== HEADLINE ===== */
  .ice-headline-text {
    text-align: center;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 0 var(--ice-pad);
    display: flex;
  }
  .ice-headline-footer {
    color: #1a365d;
  }
  .ice-headline-footer .ice-btn {
    background: #1a365d;
    border-color: #1a365d;
  }
  .ice-headline-wrapper {
    text-align: center;
    max-width: 1000px;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    margin: 0 auto;
  }
  .ice-headline-big {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-headline-big {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  .ice-highlight {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .ice-highlight-image {
    aspect-ratio: 2;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  @media (max-width: 1024px) {
    .ice-highlight-image {
      height: calc(100svh - var(--ice-header-height));
      aspect-ratio: auto;
    }
  }
  .ice-highlight-image:after {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 130% at 10% 100%, rgba(9, 16, 30, 0.6) 0%, rgba(9, 16, 30, 0.32) 26%, rgba(9, 16, 30, 0.05) 48%, rgba(9, 16, 30, 0) 62%),
      linear-gradient(0deg, rgba(9, 16, 30, 0.4) 0%, rgba(9, 16, 30, 0) 40%);
  }
  .ice-highlight-image img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-highlight-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 56px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-highlight-overlay p {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin-bottom: 15px;
    font-size: 12px;
    line-height: 1.4;
  }
  .ice-highlight-overlay h2 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-highlight-overlay h2 {
      letter-spacing: -0.01em;
      font-size: 56px;
      line-height: 1.05;
      max-width: 65%;
    }
  }

  /* ===== HERO TRUST ===== */
