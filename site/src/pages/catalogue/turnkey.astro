        b.classList.remove('active');
        if (b.getAttribute('data-tab') == stageId) {
          b.classList.add('active');
        }
      });

      const data = STAGE_DATA[stageId];
      if (data) {
        showcaseTitle.textContent = data.title;
        showcaseSubTag.textContent = data.subTag;
        showcaseDesc.textContent = data.desc;
        showcaseIllusCol.innerHTML = STAGE_ILLUSTRATIONS[stageId];

        showcaseDelivList.innerHTML = data.deliverables.map(d => `
          <div class="panel-deliv-item" style="display:flex; align-items:flex-start; gap:0.5rem; font-size:0.85rem; color:#111827; line-height:1.35;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1e3a8a" stroke-width="2.5" style="width:14px; height:14px; min-width:14px; min-height:14px; flex-shrink:0; margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>
            <span>${d}</span>
          </div>
        `).join('');
      }
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        selectStage(btn.getAttribute('data-tab'));
      });
    });

    // 2. Scope Estimator Widget
    let currentIndustry = "Petrochemical & Gas";
    let currentArea = 250;

    const indBtns = document.querySelectorAll('.qb-ind-btn');
    const areaSlider = document.getElementById('qbAreaSlider');
    const areaVal = document.getElementById('qbAreaVal');
    const checkboxes = document.querySelectorAll('#qbChecklist input[type="checkbox"]');

    const sumIndustry = document.getElementById('sumIndustry');
    const sumArea = document.getElementById('sumArea');
    const sumTags = document.getElementById('sumTags');

    function updateQuoteSummary() {
      const checkedBoxes = Array.from(checkboxes).filter(cb => cb.checked);

      sumIndustry.textContent = currentIndustry;
      sumArea.textContent = `${currentArea} m²`;

      const tagsMap = {
        1: "BIM 3D Design", 2: "HVAC Ducting", 3: "Instrument BOQ", 4: "LIMS Server",
        5: "FAT Certificate", 6: "SAT Handover", 7: "PMC Service", 8: "SOP Training"
      };

      const activeTags = checkedBoxes.map(cb => tagsMap[cb.getAttribute('data-s')]);
      sumTags.innerHTML = activeTags.map(t => `<span class="qb-mini-tag">${t}</span>`).join('');
    }

    indBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        indBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentIndustry = btn.getAttribute('data-ind');
        updateQuoteSummary();
      });
    });

    if (areaSlider) {
      areaSlider.addEventListener('input', (e) => {
        currentArea = e.target.value;
        areaVal.textContent = `${currentArea} sq. meters`;
        updateQuoteSummary();
      });
    }

    checkboxes.forEach(cb => cb.addEventListener('change', updateQuoteSummary));
  });
</script>

</Layout>
