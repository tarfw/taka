---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Turnkey Laboratory Engineering Projects UAE — TAKA Scientific"
  description="Single-source EPC turnkey laboratory engineering solutions in UAE. Complete lab design, HVAC architecture, analytical instruments, LIMS software, FAT/SAT validation, and lifetime maintenance."
  hasHero={true}
>

<!-- ═══ ACCURATE STYLES (MATCHING GLOBAL SITE DESIGN SYSTEM FONTS) ═══ -->
<style is:global>
  /* Global SVG Protection for Dynamically Injected Elements */
  .panel-deliv-item svg,
  .panel-deliv-list svg {
    width: 14px !important;
    height: 14px !important;
    min-width: 14px !important;
    min-height: 14px !important;
    max-width: 14px !important;
    max-height: 14px !important;
    stroke: #1e3a8a !important;
    flex-shrink: 0 !important;
    margin-top: 2px !important;
  }
</style>

<style>
  .turnkey-page {
    background-color: #ffffff;
    color: var(--color-text);
    font-family: var(--font-sans);
    overflow-x: hidden;
  }

  /* ═══ HERO SECTION ═══ */
  .daylight-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-image: url('/bg1.webp');
    background-size: cover;
    background-position: center;
    color: #ffffff;
    padding-top: calc(var(--nav-height, 90px) + 2rem);
    padding-bottom: 4rem;
    overflow: hidden;
  }

  /* Dark Overlay */
  .daylight-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 17, 23, 0.65) 0%,
      rgba(15, 17, 23, 0.45) 50%,
      rgba(15, 17, 23, 0.8) 100%
    );
    z-index: 1;
  }

  /* Fine Crosshair Grid Lines */
  .daylight-grid-crosshairs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .grid-line-v {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.16);
  }

  .grid-line-h {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.16);
  }

  .line-v-1 { left: 6%; }
  .line-v-2 { left: 66%; }
  .line-v-3 { right: 6%; }

  .line-h-1 { top: 22%; }
  .line-h-2 { top: 76%; }

  /* Main Hero Content Layout */
  .daylight-hero-body {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 3rem;
    align-items: end;
    flex: 1;
  }

  @media (max-width: 1024px) {
    .daylight-hero-body { grid-template-columns: 1fr; }
  }

  /* Left Main Column Typography */
  .hero-tag-mono {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.5rem;
    display: block;
  }

  .hero-display-title {
    font-family: var(--font-sans);
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 1.5rem;
    max-width: 820px;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .hero-display-sub {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    max-width: 600px;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  /* Right Column HUD Stats */
  .hero-hud-col {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .hero-hud-col { display: none; }
  }

  .hud-top-stat { text-align: right; }

  .hud-stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hud-stat-val {
    font-family: var(--font-sans);
    font-size: 1.85rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-top: 0.15rem;
  }

  /* Vibrant Accent Square Tile */
  .vibrant-accent-tile {
    width: 250px;
    height: 250px;
    margin-left: auto;
    background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
    border-radius: 4px;
    box-shadow: 0 25px 50px rgba(30, 58, 138, 0.35);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    transition: transform 0.3s ease;
  }

  .vibrant-accent-tile:hover { transform: scale(1.03); }

  .tile-texture-overlay {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.12),
      rgba(255, 255, 255, 0.12) 12px,
      transparent 12px,
      transparent 24px
    );
  }

  .tile-label {
    position: relative;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 1.5rem;
    color: #ffffff;
    font-weight: 600;
    line-height: 1.15;
  }

  .tile-sub {
    position: relative;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Lower Right Grid HUD Metrics */
  .hud-bottom-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 0.5rem;
  }

  .hud-metric-box { font-family: var(--font-mono); }

  .hud-metric-tag {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hud-metric-val {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meter-bar-track {
    width: 90px;
    height: 6px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 10px;
    margin-top: 0.35rem;
    overflow: hidden;
  }

  .meter-bar-fill {
    width: 100%;
    height: 100%;
    background: #ffffff;
  }

  /* ═══ LIFECYCLE SECTION (PURE WHITE BG & CRISP CARDS) ═══ */
  .daylight-lifecycle-section {
    background: #ffffff;
    padding: 3rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .section-header-center {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 2rem auto;
  }

  .daylight-step-tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1e3a8a;
    margin-bottom: 0.75rem;
    display: block;
  }

  .daylight-section-title {
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0 0 0.75rem;
    max-width: 20ch;
  }

  .daylight-section-sub {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
    max-width: 44ch;
  }

  @media (min-width: 1024px) {
    .daylight-section-title {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  /* Master Grid Layout: Left Vertical Stage Tabs + Right Content Card */
  .daylight-lifecycle-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (max-width: 1024px) {
    .daylight-lifecycle-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* Left Side Vertical Navigation Bar */
  .vertical-stage-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (max-width: 1024px) {
    .vertical-stage-nav {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
      gap: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }
    .vertical-stage-nav::-webkit-scrollbar { display: none; }
  }

  .v-stage-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: #ffffff;
    border: 1px solid #ececec;
    border-radius: 4px;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease;
  }

  @media (max-width: 1024px) {
    .v-stage-tab {
      flex-shrink: 0;
      padding: 8px 14px;
    }
    .v-stage-sub, .v-stage-arrow { display: none; }
  }

  .v-stage-tab:hover {
    border-color: #cbd5e1;
  }

  .v-stage-tab.active {
    border-color: #1a365d;
  }

  .v-stage-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #6b7280;
    letter-spacing: 0.01em;
  }

  .v-stage-tab.active .v-stage-num {
    color: #1a365d;
  }

  .v-stage-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1px;
  }

  .v-stage-name {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 500;
    color: #262626;
    line-height: 1.25;
  }

  .v-stage-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #9ca3af;
    letter-spacing: 0.01em;
  }

  .v-stage-arrow {
    stroke: #9ca3af;
    transition: transform 0.2s ease, stroke 0.2s ease;
    display: none;
  }

  .v-stage-tab:hover .v-stage-arrow,
  .v-stage-tab.active .v-stage-arrow {
    stroke: #1a365d;
  }

  /* Right Side Active Showcase Card */
  .daylight-showcase-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .daylight-showcase-card {
      grid-template-columns: 1fr;
      padding: 1.5rem;
      gap: 1.5rem;
    }
  }

  .showcase-content-col { display: flex; flex-direction: column; gap: 0; }

  .showcase-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: #111827;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .showcase-sub-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1e3a8a;
    margin-bottom: 0.75rem;
    display: block;
  }

  .showcase-desc {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .deliv-list-header {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: #9ca3af;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .panel-deliv-list { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; }

  .panel-deliv-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: #111827;
    line-height: 1.35;
  }

  /* Right Side Illustration Container */
  .showcase-illus-col {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }

  .showcase-illus-col svg { width: 100%; height: auto; max-height: 260px; }

  /* Rectangular Solid Navy Buttons */
  .tk-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: #1a365d;
    color: #ffffff;
    height: 32px;
    padding: 0 36px;
    border: 1px solid #1a365d;
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }

  .tk-btn-primary:hover {
    background: #ffffff !important;
    color: #1a365d !important;
    border-color: #1a365d !important;
  }

  .tk-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 2.25rem;
    background: #ffffff;
    color: #1e3a8a;
    border: 1px solid #1e3a8a;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .tk-btn-secondary:hover {
    background: #f8fafc;
    border-color: #172554;
    color: #172554;
  }

  /* Turnkey Scope Builder */
  .quote-section {
    background: #ffffff;
    padding: 3rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .quote-card-container {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
  }

  @media (max-width: 990px) {
    .quote-card-container { grid-template-columns: 1fr; padding: 1.5rem; }
  }

  .qb-group-title {
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: #262626;
    margin-bottom: 0.65rem;
  }

  .qb-industry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 600px) {
    .qb-industry-grid { grid-template-columns: 1fr; }
  }

  .qb-ind-btn {
    padding: 0.5rem 0.7rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: #111827;
    cursor: pointer;
    text-align: center;
  }

  .qb-ind-btn:hover { border-color: #1e3a8a; }
  .qb-ind-btn.active {
    background: #1e3a8a;
    border-color: #1e3a8a;
    color: #ffffff;
  }

  .qb-range-wrapper { margin-bottom: 1.25rem; }
  .qb-range-header { display: flex; justify-content: space-between; margin-bottom: 0.35rem; font-family: var(--font-sans); font-size: 0.85rem; }
  .qb-range-val { font-family: var(--font-mono); font-weight: 700; color: #1e3a8a; }
  .qb-range-slider { width: 100%; accent-color: #1e3a8a; cursor: pointer; }

  .qb-stages-checklist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 600px) {
    .qb-stages-checklist { grid-template-columns: 1fr; }
  }

  .qb-check-lbl {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .qb-check-lbl input[type="checkbox"] { accent-color: #1e3a8a; width: 14px; height: 14px; }

  .qb-summary-panel {
    background: #ffffff;
    border: 1px solid rgba(30, 58, 138, 0.2);
    border-radius: 4px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .qb-summary-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  .qb-summary-row { display: flex; justify-content: space-between; margin-bottom: 0.6rem; font-family: var(--font-sans); font-size: 0.85rem; }
  .qb-summary-lbl { color: #6b7280; }
  .qb-summary-val { font-family: var(--font-mono); font-weight: 600; color: #1e3a8a; }

  .qb-deliv-box {
    background: #ffffff;
    border: 1px dashed #d1d5db;
    border-radius: 2px;
    padding: 0.75rem;
    margin: 0.85rem 0;
  }

  .qb-deliv-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: #1e3a8a;
    margin-bottom: 0.35rem;
  }

  .qb-deliv-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .qb-mini-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    background: rgba(30, 58, 138, 0.08);
    border-radius: 2px;
    color: #1e3a8a;
    font-weight: 500;
  }

  /* ══════════ FINAL CTA ABOVE FOOTER ══════════ */
  .planner-cta-section {
    background: #fff;
    color: #1a365d;
    min-height: 100svh;
    justify-content: center;
    padding: 80px 1.5rem;
    text-align: center;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    position: relative;
    z-index: 1;
  }

  .planner-cta-title {
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
    max-width: 20ch;
  }

  .planner-cta-sub {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
    max-width: 44ch;
  }

  @media (min-width: 1024px) {
    .planner-cta-section {
      gap: 30px;
    }
    .planner-cta-title {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  .btn-navy-square {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: #1a365d;
    color: #ffffff;
    height: 32px;
    padding: 0 36px;
    border: 1px solid #1a365d;
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }

  .btn-navy-square:hover {
    background: var(--ice-white) !important;
    color: #1a365d !important;
    border-color: #1a365d !important;
  }

  /* ═══ TABLET & MOBILE REFINEMENTS (extra polish on top of existing media queries) ═══ */

  /* Slim intermediate widths: keep hero title comfortable */
  @media (max-width: 820px) {
    .daylight-hero {
      padding-top: calc(var(--nav-height, 66px) + 1.5rem);
    }
    .daylight-hero-body {
      padding: 1.5rem 1.25rem;
    }
    .hero-display-title {
      font-size: clamp(2.4rem, 8vw, 3.4rem);
    }
  }

  /* Phones & small tablets */
  @media (max-width: 640px) {
    .daylight-hero {
      padding-top: calc(var(--nav-height, 56px) + 1rem);
      padding-bottom: 2.5rem;
    }
    .daylight-hero-body {
      padding: 1.25rem 1rem;
      gap: 1.75rem;
    }
    .hero-tag-mono {
      font-size: 0.7rem;
      margin-bottom: 1.1rem;
    }
    .hero-display-title {
      font-size: clamp(2rem, 9.5vw, 2.9rem);
      margin-bottom: 1.1rem;
    }
    .hero-display-sub {
      font-size: 0.98rem;
      margin-bottom: 1.75rem;
    }

    .daylight-lifecycle-section {
      padding: 2.5rem 0;
    }
    .section-header-center {
      margin: 0 auto 1.5rem auto;
    }
    .daylight-showcase-card {
      padding: 1.25rem;
      gap: 1.25rem;
    }
    .showcase-title {
      font-size: clamp(1.5rem, 6.5vw, 2rem);
    }
    .showcase-illus-col {
      min-height: 200px;
      padding: 1rem;
    }
    .tk-btn-primary {
      width: 100%;
      padding: 0 16px;
    }

    .quote-section {
      padding: 2.5rem 0;
    }
