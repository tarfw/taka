</div>

</Layout>

<script>
  document.querySelectorAll('.ice-slider').forEach(slider => {
    const scroller = slider.querySelector('.ice-slider-items, .ice-feature-items');
    const prev = slider.querySelector('.ice-slider-prev');
    const next = slider.querySelector('.ice-slider-next');
    if (!scroller || !prev || !next) return;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      prev.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= max - 1;
    };
    const step = () => {
      const item = scroller.querySelector('.ice-slider-item');
      return item ? item.offsetWidth : scroller.clientWidth;
    };

    prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', update, { passive: true });
    update();
    window.addEventListener('resize', update);
  });
</script>

<style>
  .ice-page {
    --ice-pad: 24px;
    --ice-black: #262626;
    --ice-white: #ffffff;
    --ice-border: #ececec;
    --ice-image-bg: #ececec;
    --ice-sans: var(--font-sans);
    --ice-mono: var(--font-mono);
    --ice-opacity: 0.35;
    --ice-underline-offset: 0.3em;
    --ice-btn-height: 32px;
    --ice-page-gap: 120px;
    --ice-header-height: 52px;
    background: var(--ice-white);
    color: var(--ice-black);
    font-size: 10px;
    flex-direction: column;
    gap: var(--ice-page-gap);
    display: flex;
  }
  @media (max-width: 1024px) {
    .ice-page { --ice-page-gap: 72px; }
  }

  /* â•â•â• BUTTONS â•â•â• */
  .ice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: var(--ice-black);
    color: var(--ice-white);
    height: var(--ice-btn-height);
    padding: 0 36px;
    border: 1px solid var(--ice-black);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  @media (max-width: 1024px) {
    .ice-btn { padding: 0 28px; }
  }
  .ice-btn span { pointer-events: none; }

  .ice-btn-white {
    background: var(--ice-white);
    color: var(--ice-black);
    border-color: var(--ice-white);
  }

  .ice-btn-outlined {
    background: transparent;
    color: var(--ice-white);
    border-color: rgba(255, 255, 255, 0.5);
    padding: 0 12px;
  }
  @media (hover: hover) {
    .ice-btn:hover {
      background: rgba(38, 38, 38, 0.9);
      color: var(--ice-white);
      border-color: rgba(38, 38, 38, 0.9);
    }
    .ice-btn-white:hover {
      background: var(--ice-black);
      color: var(--ice-white);
      border-color: var(--ice-black);
    }
    .ice-btn-outlined:hover {
      border-color: var(--ice-white);
      background: transparent;
    }
  }

  /* â•â•â• HERO â€” ModuleHighlight â•â•â• */
  .ice-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
  }
  .ice-hero-image {
    height: 100svh;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .ice-hero-image:after {
    content: "";
    pointer-events: none;
    background: linear-gradient(#0003 0% 70%, #0003 70%, #0000004d 80%, #0006 100%);
    position: absolute;
    inset: 0;
  }
  .ice-hero-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-hero-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 150px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-hero-overlay h1 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-hero-overlay h1 {
      letter-spacing: -0.02em;
      font-size: 88px;
      line-height: 0.9;
      max-width: 55%;
    }
    .ice-hero-overlay { padding-bottom: 76px; }
  }
  .ice-hero-buttons {
    flex-flow: wrap;
    gap: 12px;
    display: flex;
  }

  /* â•â•â• SLIDER BASE â€” FeatureSlider â•â•â• */
  .ice-slider-section {
    padding: 0;
  }
  .ice-slider {
    flex-direction: column;
    display: flex;
  }
  .ice-slider-title {
    padding: 0 var(--ice-pad) 14px;
    width: 100%;
    color: var(--ice-black);
    align-items: center;
    display: flex;
  }
  @media (min-width: 1024px) {
    .ice-slider-title { padding: 0 var(--ice-pad) 17px; }
  }
  .ice-slider-title h2 {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;
  }
  .ice-slider-controls {
    font-family: var(--ice-mono);
    letter-spacing: -0.01em;
    gap: 14px;
    margin-left: auto;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-controls button {
    font-family: var(--ice-mono);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    background: none;
    border: none;
    padding: 0;
    color: var(--ice-black);
    cursor: pointer;
    text-transform: uppercase;
  }
  .ice-slider-controls button:disabled {
    opacity: var(--ice-opacity);
    pointer-events: none;
  }
  @media (max-width: 1024px) {
    .ice-slider-title { padding-bottom: 14px; }
    .ice-slider-controls { display: none; }
    .ice-slider-title-wrapper { justify-content: space-between; }
  }
  .ice-slider-title-wrapper {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    align-items: center;
    gap: 16px;
    width: 100%;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-title-wrapper a {
    opacity: var(--ice-opacity);
    text-decoration: none;
    color: inherit;
  }
  @media (hover: hover) {
    .ice-slider-title-wrapper a:hover {
      opacity: 1;
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }
  @media (max-width: 1024px) {
    .ice-slider-title-wrapper a {
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }

  .ice-slider-items,
  .ice-feature-items {
    width: calc(100% + var(--ice-gap));
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-left: calc(var(--ice-gap) * -1);
    overflow-x: scroll;
    scrollbar-width: none;
  }
  .ice-slider-items::-webkit-scrollbar,
  .ice-feature-items::-webkit-scrollbar { display: none; }
  .ice-slider-track {
    display: flex;
  }
  .ice-slider-item {
    flex: 0 0 var(--ice-flex);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-width: 0;
    padding-left: var(--ice-gap);
    position: relative;
  }

  /* Product slider */
  .ice-slider-items {
    --ice-gap: 1px;
    --ice-flex: calc(100% / 1.3);
  }
  @media (min-width: 1024px) {
    .ice-slider-items {
      --ice-flex: calc(100% / 5);
    }
  }

  /* Feature slider (categories) */
  .ice-feature-items {
    --ice-gap: 60px;
    --ice-flex: 100%;
  }
  @media (min-width: 1024px) {
    .ice-feature-items {
      --ice-gap: 98px;
      --ice-flex: calc(100% / 5);
    }
  }

  /* â•â•â• FEATURE ITEM (category card) â•â•â• */
  .ice-feature-card {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
  }
  .ice-feature-image {
    aspect-ratio: 4 / 5;
    width: 100%;
    position: relative;
    overflow: hidden;
    background: var(--ice-image-bg);
  }
  .ice-feature-image:after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 33.33%;
    background: linear-gradient(#0000 0%, #00000080 50%, #000c 100%);
    opacity: 0.6;
    pointer-events: none;
  }
  .ice-feature-image img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    padding: 24px;
  }
  .ice-feature-category {
    position: absolute;
    bottom: 20px;
