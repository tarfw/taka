---
import Layout from '../../layouts/Layout.astro';
import ProductCardMini from '../../components/ProductCardMini.astro';
import productData from '../../data/products.json';

const category = productData.categories.find(c => c.id === 'analytical-equipments');
if (!category) throw new Error('Category not found');

const subcategories = category.brands.flatMap(brand =>
  brand.subcategories.map(sc => ({
    id: sc.id,
    name: sc.name,
    brandId: brand.id,
    brandName: brand.name,
    products: sc.products.map(p => ({
      ...p,
      brandName: brand.name,
      subcategoryName: sc.name,
      categoryName: category.name
    }))
  }))
);


const productsIn = (ids) =>
  subcategories.filter(sc => ids.includes(sc.id)).flatMap(sc => sc.products);

const gcSpecialsIds = ['cryotrap', 'olfactometer', 'ezprep'];
const gcSystems = productsIn(['gc-systems']);
const inletsProducts = productsIn(['gc-inlets-accessories']).filter(p => !gcSpecialsIds.includes(p.id));
const gcSpecialsProducts = productsIn(['gc-inlets-accessories'])
  .filter(p => gcSpecialsIds.includes(p.id))
  .map(p => ({ ...p, subcategoryName: 'GC Specials' }));
const detectorProducts = productsIn(['detectors']);
const samplePrepProducts = productsIn(['automated-sample-prep']);
const labSupportProducts = productsIn(['lab-support-equipment']);

const productSections = [
  {
    id: 'gc-systems',
    title: 'Gas chromatography systems',
    sub: 'Complete gas analysis systems — natural gas, refinery gas, oxygenates and simulated distillation.',
    products: gcSystems,
  },
  {
    id: 'detectors',
    title: 'Detectors',
    sub: 'Atomic emission detection with elemental selectivity and picogram-level sensitivity.',
    products: detectorProducts,
  },
  {
    id: 'inlets',
    title: 'Sample introduction & inlets',
    sub: 'Precision inlets and accessories for maximum sensitivity and reproducibility.',
    products: inletsProducts,
  },
  {
    id: 'gc-specials',
    title: 'Gas chromatography specials',
    sub: 'Special GC modules — cryogenic trapping, olfactory detection and preparative fraction collection.',
    products: gcSpecialsProducts,
  },
  {
    id: 'automated-sample-prep',
    title: 'Automated sample preparation',
    sub: 'Robotic and fully automated sample preparation for reproducible, unattended analysis.',
    products: samplePrepProducts,
  },
  {
    id: 'lab-support-equipment',
    title: 'Lab support equipment',
    sub: 'Gas generators and support equipment that keep your lab running.',
    products: labSupportProducts,
  },
];

const categoryCards = [
  { name: 'Atomic Emission Detector', image: '/atomic.jpg', href: '#detectors' },
  { name: 'Sample Introduction Systems', image: '/gassampler.jpg', href: '#inlets' },
  { name: 'UNIS Inlets Range', image: '/unix.png', href: '#inlets' },
  { name: 'Gas Chromatography Specials', image: '/jaschromo.png', href: '#gc-specials', contain: true },
  { name: 'Customized Analyzers', image: '/customanalyzer.png', href: '#gc-systems' },
  { name: 'Automated Sample Prep', image: '/gerstel.png', href: '#automated-sample-prep' },
  { name: 'Lab Support Equipment', image: '/labsupport.png', href: '#lab-support-equipment', contain: true },
];
---

<Layout
  title="Analytical Instruments — Gas Chromatography Systems"
  hasHero={true}
  description="Precision analytical instruments — gas chromatography systems, sample introduction inlets and detectors for natural gas, refinery and environmental analysis."
>

<div class="ice-page">

  <!-- ═══ HERO ═══ -->
  <section class="ice-hero hero-container" data-view>
    <div class="ice-hero-image">
      <img src="/bg4.jpg" alt="TAKA Scientific analytical instrumentation" class="ice-hero-img" fetchpriority="high" data-parallax="zoom" />
      <div class="ice-hero-overlay">
        <h1>Precision analytical instruments for every analysis</h1>
        <div class="ice-hero-buttons">
          <a href="#range" class="ice-btn ice-btn-outlined"><span>Browse Instruments</span></a>
        </div>
      </div>
      <div class="ice-hero-trust">
        <p>Authorized distributor &amp; service</p>
        <p>ASTM &amp; ISO compliant methods</p>
        <p>On-site delivery &amp; UAE service</p>
        <p>Technical support &amp; spare parts</p>
      </div>
    </div>
  </section>

  <!-- ═══ HEADLINE TEXT ═══ -->
  <section class="ice-headline-text ice-headline-footer" data-view>
    <div class="ice-headline-wrapper">
      <p class="ice-headline-big">Gas chromatography systems, detectors, and automated sample preparation for industrial analysis.</p>
    </div>
  </section>

  <!-- ═══ CATEGORIES ═══ -->
  <section class="ice-cat-section" id="range" data-view>
    <div class="ice-cat-head">
      <span class="ice-cat-overline">Instrument Categories</span>
      <h2 class="ice-cat-title">Find your instrument</h2>
    </div>
    <div class="ice-cat-grid">
      {categoryCards.map((card) => (
        <a href={card.href} class="ice-cat-card">
          <span class={'ice-cat-media' + (card.contain ? ' ice-cat-media-contain' : '')}>
            <img src={card.image} alt={card.name} loading="lazy" decoding="async" class={card.contain ? 'ice-cat-img-contain' : undefined} />
          </span>
          <span class="ice-cat-meta">
            <span class="ice-cat-name">{card.name}</span>
            <span class="ice-cat-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ HIGHLIGHT ═══ -->
  <section class="ice-highlight" data-view>
    <div class="ice-highlight-image clip--top_left">
      <img src="/gestrel.png" alt="Analytical instruments laboratory" loading="lazy" />
    </div>
    <div class="ice-highlight-overlay">
      <h2>Complete Analytical Instrumentation Range</h2>
      <div class="ice-hero-buttons">
        <a href="#gc-systems" class="ice-btn ice-btn-outlined"><span>View All Systems</span></a>
        <a href="/contact" class="ice-btn ice-btn-outlined"><span>Request Technical Quote</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ PRODUCT SECTIONS ═══ -->
  {productSections.map(section => (
    <section class="ice-slider-section" id={section.id} data-view>
      <div class="ice-slider">
        <div class="ice-slider-title">
          <div class="ice-slider-title-wrapper">
            <h2>{section.title}</h2>
          </div>
          <div class="ice-slider-controls">
            <button class="ice-slider-prev" aria-label="Previous" disabled>Prev</button>
            <button class="ice-slider-next" aria-label="Next" disabled>Next</button>
          </div>
        </div>
        <p class="ice-slider-sub">{section.sub}</p>
        <div class="ice-slider-items">
          <div class="ice-slider-track">
            {section.products.map(p => (
              <div class="ice-slider-item">
                <ProductCardMini
                  id={p.id}
                  name={p.name}
                  fullName={p.fullName}
                  brandName={p.brandName}
                  subcategoryName={p.subcategoryName}
                  image={p.image}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ═══ CONTACT CTA ═══ -->
  <section class="ice-cta" data-view>
    <h2>Ready to find your instrument?</h2>
    <p>Tell us about your analysis and we&#39;ll recommend the right setup for you.</p>
    <a href="/contact" class="ice-btn ice-btn-white"><span>Talk to our team</span></a>
  </section>

</div>

</Layout>

<script>
  document.querySelectorAll('.ice-slider').forEach(slider => {
    const scroller = slider.querySelector('.ice-slider-items');
    const prev = slider.querySelector('.ice-slider-prev');
    const next = slider.querySelector('.ice-slider-next');
    if (!scroller || !prev || !next) return;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      prev.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= max - 1;
    };
    const step = () => {
      const item = scroller.querySelector('.ice-slider-item');
      return item ? item.offsetWidth : scroller.clientWidth;
    };

    prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', update, { passive: true });
    update();
    window.addEventListener('resize', update);
  });
</script>

<style>
  .ice-page {
    --ice-pad: 24px;
    --ice-black: #262626;
    --ice-white: #ffffff;
    --ice-border: #ececec;
    --ice-image-bg: #ececec;
    --ice-sans: var(--font-sans);
    --ice-mono: var(--font-mono);
    --ice-opacity: 0.35;
    --ice-underline-offset: 0.3em;
    --ice-btn-height: 32px;
    --ice-page-gap: 120px;
    --ice-header-height: 52px;
    background: var(--ice-white);
    color: var(--ice-black);
    font-size: 10px;
    flex-direction: column;
    gap: var(--ice-page-gap);
    display: flex;
  }
  @media (max-width: 1024px) {
    .ice-page { --ice-page-gap: 72px; }
  }

  /* â•â•â• BUTTONS â•â•â• */
  .ice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: var(--ice-black);
    color: var(--ice-white);
    height: var(--ice-btn-height);
    padding: 0 36px;
    border: 1px solid var(--ice-black);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  @media (max-width: 1024px) {
    .ice-btn { padding: 0 28px; }
  }
  .ice-btn span { pointer-events: none; }

  .ice-btn-white {
    background: var(--ice-white);
    color: var(--ice-black);
    border-color: var(--ice-white);
  }

  .ice-btn-outlined {
    background: transparent;
    color: var(--ice-white);
    border-color: rgba(255, 255, 255, 0.5);
    padding: 0 12px;
  }

  .ice-cta .ice-btn-white {
    background: #1a365d;
    color: var(--ice-white);
    border-color: #1a365d;
  }

  .ice-cta .ice-btn-white:hover {
    background: var(--ice-white) !important;
    color: #1a365d !important;
    border-color: #1a365d !important;
  }

  @media (hover: hover) {
    .ice-btn:hover {
      background: rgba(38, 38, 38, 0.9);
      color: var(--ice-white);
      border-color: rgba(38, 38, 38, 0.9);
    }
    .ice-btn-white:hover {
      background: var(--ice-black);
      color: var(--ice-white);
      border-color: var(--ice-black);
    }
    .ice-btn-outlined:hover {
      border-color: var(--ice-white);
      background: transparent;
    }
  }

  /* â•â•â• HERO â€” ModuleHighlight â•â•â• */
      background: rgba(255, 255, 255, 0.2);
    }
  }

  /* ═══ HERO — ModuleHighlight ═══ */
  .ice-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
  }
  .ice-hero-image {
    height: 100svh;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .ice-hero-image:after {
    content: "";
    pointer-events: none;
    background: 
      linear-gradient(to bottom, rgba(10, 22, 40, 0.7) 0%, rgba(10, 22, 40, 0.45) 40%, rgba(10, 22, 40, 0.8) 75%, rgba(10, 22, 40, 0.96) 100%),
      radial-gradient(ellipse at 30% 40%, rgba(10, 22, 40, 0.5) 0%, rgba(10, 22, 40, 0.85) 100%);
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .ice-hero-img,
  .ice-hero-video {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-hero-overlay {
    padding-left: var(--ice-pad);
    padding-right: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 120px;
    display: flex;
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .ice-hero-overlay h1 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1.05;
    font-weight: 600;
    margin: 0 0 25px;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6);
  }
  @media (min-width: 1024px) {
    .ice-hero-overlay h1 {
      letter-spacing: -0.02em;
      font-size: 88px;
      line-height: 0.9;
      max-width: 55%;
    }
    .ice-hero-overlay { padding-bottom: 96px; }
  }
  .ice-hero-buttons {
    flex-flow: wrap;
    gap: 12px;
    display: flex;
  }

  /* â•â•â• SLIDER BASE â€” FeatureSlider â•â•â• */
  .ice-slider-section {
    padding: 0;
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
  }
  .ice-slider {
    flex-direction: column;
    display: flex;
  }
  .ice-slider-title {
    padding: 0 var(--ice-pad) 14px;
    width: 100%;
    color: var(--ice-black);
    align-items: center;
    display: flex;
  }
  @media (min-width: 1024px) {
    .ice-slider-title { padding: 0 var(--ice-pad) 17px; }
  }
  .ice-slider-title h2 {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;
  }
  .ice-slider-controls {
    font-family: var(--ice-mono);
    letter-spacing: -0.01em;
    gap: 14px;
    margin-left: auto;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-controls button {
    font-family: var(--ice-mono);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    background: none;
    border: none;
    padding: 0;
    color: var(--ice-black);
    cursor: pointer;
    text-transform: uppercase;
  }
  .ice-slider-controls button:disabled {
    opacity: var(--ice-opacity);
    pointer-events: none;
  }
  @media (max-width: 1024px) {
    .ice-slider-title { padding-bottom: 14px; }
    .ice-slider-controls { display: none; }
    .ice-slider-title-wrapper { justify-content: space-between; }
  }
  .ice-slider-title-wrapper {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    align-items: center;
    gap: 16px;
    width: 100%;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
  }
  .ice-slider-title-wrapper a {
    opacity: var(--ice-opacity);
    text-decoration: none;
    color: inherit;
  }
  @media (hover: hover) {
    .ice-slider-title-wrapper a:hover {
      opacity: 1;
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }
  @media (max-width: 1024px) {
    .ice-slider-title-wrapper a {
      text-underline-offset: var(--ice-underline-offset);
      text-decoration: underline;
    }
  }

  .ice-slider-items {
    width: calc(100% + var(--ice-gap));
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-left: calc(var(--ice-gap) * -1);
    overflow-x: scroll;
    scrollbar-width: none;
  }
  .ice-slider-items::-webkit-scrollbar { display: none; }
  .ice-slider-track {
    display: flex;
  }
  .ice-slider-item {
    flex: 0 0 var(--ice-flex);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-width: 0;
    padding-left: var(--ice-gap);
    position: relative;
  }

  /* Product slider */
  .ice-slider-items {
    --ice-gap: 1px;
    --ice-flex: calc(100% / 1.3);
  }
  @media (min-width: 1024px) {
    .ice-slider-items {
      --ice-flex: calc(100% / 5);
    }
  }

  /* â•â•â• CATEGORIES â€” Explore the range â•â•â• */
  .ice-cat-section {
    padding: 0 var(--ice-pad);
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
    border-top: 1px solid var(--ice-border);
    padding-top: 24px;
  }
  .ice-cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    margin-bottom: 28px;
  }
  .ice-cat-overline {
    font-family: var(--ice-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(38, 38, 38, 0.55);
  }
  .ice-cat-title {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 500;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-cat-title {
      font-size: 24px;
    }
  }
  .ice-cat-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    display: grid;
  }
  @media (min-width: 768px) {
    .ice-cat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 1024px) {
    .ice-cat-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--ice-pad);
    }
  }
  .ice-cat-card {
    flex-direction: column;
    text-decoration: none !important;
    color: inherit;
    background: var(--ice-white);
    border: 1px solid var(--ice-border);
    border-radius: var(--radius-sm);
    min-width: 0;
    display: flex;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .ice-cat-media {
    aspect-ratio: 4 / 3;
    background: var(--ice-image-bg);
    overflow: hidden;
    display: block;
    position: relative;
  }
  .ice-cat-media img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    display: block;
    padding: 16px;
    background: var(--ice-white);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ice-cat-media-contain {
    background: #fff;
  }
  .ice-cat-media img.ice-cat-img-contain {
    object-fit: contain;
    padding: 24px;
  }
  .ice-cat-meta {
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 16px 18px;
    display: flex;
    background: var(--ice-white);
  }
  .ice-cat-name {
    font-family: var(--ice-sans);
    font-size: 13.5px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--ice-black);
    text-decoration: none !important;
    transition: color 0.2s ease;
  }
  .ice-cat-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  .ice-cat-arrow svg {
    width: 16px;
    height: 16px;
  }
  @media (hover: hover) {
    .ice-cat-card:hover {
      border-color: #cbd5e1 !important;
