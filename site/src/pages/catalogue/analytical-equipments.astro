---
import Layout from '../../layouts/Layout.astro';
import IceProductCard from '../../components/IceProductCard.astro';
import productData from '../../data/products.json';

const category = productData.categories.find(c => c.id === 'analytical-equipments');
if (!category) throw new Error('Category not found');

const subcategories = category.brands.flatMap(brand =>
  brand.subcategories.map(sc => ({
    id: sc.id,
    name: sc.name,
    brandId: brand.id,
    brandName: brand.name,
    products: sc.products.map(p => ({
      ...p,
      brandName: brand.name,
      subcategoryName: sc.name,
      categoryName: category.name
    }))
  }))
);

const allProducts = subcategories.flatMap(sc => sc.products);
const gcSystems = (subcategories.find(sc => sc.id === 'gc-systems')?.products ?? []);
const inletsProducts = subcategories
  .filter(sc => ['gc-inlets-accessories', 'automated-sample-prep'].includes(sc.id))
  .flatMap(sc => sc.products);

const categoryCards = [
  { name: 'Atomic Emission Detector', image: '/products/jasmea/aed-iii-hr.png', href: '/catalogue/aed-iii-hr' },
  { name: 'Sample Introduction Systems', image: '/products/jasmea/vaporizer.png', href: '/catalogue/vaporizer' },
  { name: 'UNIS Inlets Range', image: '/products/jasmea/unis-2100.jpg', href: '/catalogue/unis-2100' },
  { name: 'Gas Chromatography Specials', image: '/products/jasmea/cryotrap.png', href: '/catalogue/cryotrap' },
  { name: 'Customized Analyzers', image: '/products/jasmea/simdis-analyzer.png', href: '/catalogue/simdis-analyzer' },
  { name: 'Automated Sample Prep', image: '/products/jasmea/mps-robotic.png', href: '/catalogue/mps-robotic' },
  { name: 'Lab Support Equipment', image: '/products/jasmea/peak-gas-generators.png', href: '/catalogue/peak-gas-generators' },
];
---

<Layout title="Analytical Equipments â€” TAKA Scientific" hasHero={true}>

<div class="ice-page">

  <!-- â•â•â• HERO â€” ModuleHighlight â•â•â• -->
  <section class="ice-hero hero-container">
    <div class="ice-hero-image">
      <img src="/bg4.jpg" alt="TAKA Scientific analytical instrumentation" class="ice-hero-img" fetchpriority="high" />
      <div class="ice-hero-overlay">
        <h1>One instrument for every analysis</h1>
        <div class="ice-hero-buttons">
          <a href="#range" class="ice-btn ice-btn-outlined"><span>Explore the range</span></a>
          <a href="/catalogue" class="ice-btn ice-btn-outlined"><span>Shop now</span></a>
        </div>
      </div>
      <div class="ice-hero-trust">
        <p>Authorized JASMEA distributor</p>
        <p>ASTM &amp; ISO compliant methods</p>
        <p>German engineering since 1997</p>
        <p>Application support that lasts</p>
      </div>
    </div>
  </section>

  <!-- â•â•â• PRODUCT SLIDER â€” Featured â•â•â• -->
  <section class="ice-slider-section">
    <div class="ice-slider">
      <div class="ice-slider-title">
        <div class="ice-slider-title-wrapper">
          <h2>Featured products</h2>
          <a href="/catalogue">Shop all</a>
        </div>
        <div class="ice-slider-controls">
          <button class="ice-slider-prev" aria-label="Previous" disabled>Prev</button>
          <button class="ice-slider-next" aria-label="Next" disabled>Next</button>
        </div>
      </div>
      <div class="ice-slider-items">
        <div class="ice-slider-track">
          {allProducts.map(p => (
            <div class="ice-slider-item">
              <IceProductCard
                id={p.id}
                name={p.name}
                fullName={p.fullName}
                brandName={p.brandName}
