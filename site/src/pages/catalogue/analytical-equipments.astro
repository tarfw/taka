    <div class="ice-grid-head">
      <h2>Built for your industry</h2>
    </div>
    <div class="ice-grid">
      <a href="/catalogue" class="ice-grid-card">
        <span class="ice-grid-label">Natural gas</span>
        <p>Complete natural gas composition analysis per ASTM D1945 and ISO 6974.</p>
      </a>
      <a href="/catalogue" class="ice-grid-card">
        <span class="ice-grid-label">Refinery &amp; petrochemical</span>
        <p>Refinery gas, oxygenates and simulated distillation for process control.</p>
      </a>
      <a href="/catalogue" class="ice-grid-card">
        <span class="ice-grid-label">Environmental</span>
        <p>Trace sulfur and atomic emission detection with picogram-level sensitivity.</p>
      </a>
      <a href="/catalogue" class="ice-grid-card">
        <span class="ice-grid-label">Research &amp; academia</span>
        <p>Flexible, modular platforms for method development and advanced research.</p>
      </a>
    </div>
  </section>

  <!-- â•â•â• SERVICES â€” Support that lasts â•â•â• -->
  <section class="ice-grid-section">
    <div class="ice-grid-head">
      <h2>Support that lasts</h2>
    </div>
    <div class="ice-grid">
      <div class="ice-grid-card">
        <span class="ice-grid-label">Installation &amp; training</span>
        <p>On-site installation and hands-on training for your team.</p>
      </div>
      <div class="ice-grid-card">
        <span class="ice-grid-label">Method development</span>
        <p>Application engineers help you validate and optimize your methods.</p>
      </div>
      <div class="ice-grid-card">
        <span class="ice-grid-label">Calibration &amp; service</span>
        <p>Scheduled maintenance, calibration and fast-turnaround repairs.</p>
      </div>
      <div class="ice-grid-card">
        <span class="ice-grid-label">Genuine spare parts</span>
        <p>Original JASMEA parts and consumables, ready when you need them.</p>
      </div>
    </div>
  </section>

  <!-- â•â•â• HEADLINE TEXT â€” Our promise â•â•â• -->
  <section class="ice-headline-text">
    <div class="ice-headline-wrapper">
      <p class="ice-headline-big">Genuine instruments. Honest advice. Support that lasts.</p>
      <a href="/about" class="ice-btn"><span>Read our promises</span></a>
    </div>
  </section>

  <!-- â•â•â• EDITORIAL HIGHLIGHT â•â•â• -->
  <section class="ice-editorial">
    <div class="ice-editorial-image">
      <img src="/heroanlytical.webp" alt="TAKA Scientific analytical laboratory" loading="lazy" />
    </div>
    <div class="ice-editorial-overlay">
      <div class="ice-editorial-text">
        <h2 class="ice-editorial-title">We&#39;re in it for the long run. â€” and so is our instrumentation.</h2>
        <p class="ice-editorial-text-p">While most suppliers put the margin first, TAKA puts our customers, our people and our partners first — with instruments that keep running, year after year.</p>
        <a href="/about" class="ice-btn ice-btn-outlined"><span>Our story</span></a>
      </div>
    </div>
  </section>

  <!-- â•â•â• CONTACT CTA â•â•â• -->
  <section class="ice-cta">
    <h2>Ready to find your instrument?</h2>
    <p>Tell us about your analysis and we&#39;ll recommend the right setup for you.</p>
    <a href="/contact" class="ice-btn ice-btn-white"><span>Talk to an expert</span></a>
