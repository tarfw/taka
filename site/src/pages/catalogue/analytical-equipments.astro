    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .ice-highlight-image {
    aspect-ratio: 2;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  @media (max-width: 1024px) {
    .ice-highlight-image {
      height: calc(100svh - var(--ice-header-height));
