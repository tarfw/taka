    }
    .ice-cat-card:hover .ice-cat-arrow {
      color: #1a365d !important;
      transform: translateX(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ice-cat-card,
    .ice-cat-media img,
    .ice-cat-name,
    .ice-cat-arrow {
      transition: none;
    }
  }

  /* â•â•â• HIGHLIGHT â€” ModuleHighlight (banner) â•â•â• */
  .ice-headline-text {
    text-align: center;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 0 var(--ice-pad);
    display: flex;
  }
  .ice-headline-footer {
    color: #1a365d;
  }
  .ice-headline-footer .ice-btn {
    background: #1a365d;
    border-color: #1a365d;
  }
  .ice-headline-wrapper {
    text-align: center;
    max-width: 1000px;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    margin: 0 auto;
  }
  .ice-headline-big {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-headline-big {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  .ice-highlight {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .ice-highlight-image {
    aspect-ratio: 2;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  @media (max-width: 1024px) {
    .ice-highlight-image {
      height: calc(100svh - var(--ice-header-height));
      aspect-ratio: auto;
    }
  }
  .ice-highlight-image:after {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 130% at 10% 100%, rgba(9, 16, 30, 0.6) 0%, rgba(9, 16, 30, 0.32) 26%, rgba(9, 16, 30, 0.05) 48%, rgba(9, 16, 30, 0) 62%),
      linear-gradient(0deg, rgba(9, 16, 30, 0.4) 0%, rgba(9, 16, 30, 0) 40%);
  }
  .ice-highlight-image img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-highlight-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
