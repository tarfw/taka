---
import Layout from '../../layouts/Layout.astro';

const categoryCards = [
  { name: 'Beakers & Glassware', image: '/products/consumables/beakers.jpg', href: '#glassware' },
  { name: 'Flasks', image: '/products/consumables/flasks.jpg', href: '#glassware' },
  { name: 'Pipette Tips', image: '/products/consumables/pipette-tips.jpg', href: '#disposables' },
  { name: 'Petri Dishes', image: '/products/consumables/petri-dishes.jpg', href: '#disposables' },
  { name: 'Filter Paper', image: '/products/consumables/filter-paper.jpg', href: '#filtration' },
  { name: 'Buffer Solutions', image: '/products/consumables/buffer-solutions.jpg', href: '#reagents' },
];

const gridSections = [
  {
    id: 'glassware',
    title: 'Glassware & plasticware',
    sub: 'Borosilicate glassware and lab plastics for every routine and analytical application.',
    cards: [
      { label: 'Beakers & Measuring Cylinders', text: 'Borosilicate 3.3 glass beakers, cylinders and mixing vessels.' },
      { label: 'Flasks', text: 'Volumetric, conical, round-bottom and reagent flasks.' },
      { label: 'Volumetric Glassware', text: 'Class A pipettes, burettes and volumetric flasks with certificates.' },
      { label: 'Bottles & Containers', text: 'Media bottles, wash bottles, jars and sample containers.' },
    ],
  },
  {
    id: 'disposables',
    title: 'Pipette tips & disposables',
    sub: 'Consistent, RNase-free disposables for confident liquid handling.',
    cards: [
      { label: 'Pipette Tips', text: 'Filtered and unfiltered tips for 0.1 µL to 10 mL pipettes.' },
      { label: 'Petri Dishes', text: 'Sterile polystyrene and glass dishes for culture work.' },
      { label: 'Tubes & Racks', text: 'Microtubes, centrifuge tubes, cryovials and tube racks.' },
      { label: 'Gloves & PPE', text: 'Nitrile and latex gloves, aprons and lab safety essentials.' },
    ],
  },
  {
    id: 'filtration',
    title: 'Filtration & paperware',
    sub: 'Filtration media and lab paper for preparation and analysis.',
    cards: [
      { label: 'Filter Paper', text: 'Qualitative and quantitative filter papers in all grades.' },
      { label: 'Membrane Filters', text: 'PES, nylon and cellulose membranes for solvent and aqueous filtration.' },
      { label: 'Syringe Filters', text: 'Ready-to-use sterile syringe filters in popular pore sizes.' },
      { label: 'Weighing & Lint-free Paper', text: 'Weighing boats, pans and lint-free wipes for balances.' },
    ],
  },
  {
    id: 'reagents',
    title: 'Reagents & standards',
    sub: 'Solutions and standards for calibration, cleaning and routine chemistry.',
    cards: [
      { label: 'Buffer Solutions', text: 'pH 4, 7 and 10 buffers plus certified calibration standards.' },
      { label: 'Reagent Kits', text: 'Ready-to-use reagent sets for common water and chemistry tests.' },
      { label: 'Cleaning Solutions', text: 'Laboratory detergents and rinsing solutions for glassware.' },
      { label: 'Desiccants & Absorbents', text: 'Silica gel, drying agents and spill absorbents.' },
    ],
  },
];
---

<Layout
  title="Laboratory Consumables — Glassware, Filtration & Reagents"
  description="Laboratory consumables from TAKA Scientific — glassware, pipette tips, filtration and reagents, always in stock and delivered fast across the UAE."
  hasHero={true}
>

<div class="ice-page">

  <!-- ─── HERO ─── -->
  <section class="ice-hero hero-container" data-view>
    <div class="ice-hero-image">
      <img src="/consumables-highlight.jpg" alt="TAKA Scientific laboratory consumables" class="ice-hero-img" fetchpriority="high" data-parallax="zoom" />
      <div class="ice-hero-overlay">
        <h1>Laboratory consumables, always in stock</h1>
        <div class="ice-hero-buttons">
          <a href="#range" class="ice-btn ice-btn-outlined"><span>Browse Consumables</span></a>
        </div>
      </div>
      <div class="ice-hero-trust">
        <p>Fast UAE delivery</p>
        <p>Genuine certified consumables</p>
        <p>Bulk &amp; routine contract pricing</p>
        <p>All major brands supported</p>
      </div>
    </div>
  </section>

  <!-- ─── HEADLINE TEXT ─── -->
  <section class="ice-headline-text ice-headline-footer" data-view>
    <div class="ice-headline-wrapper">
      <p class="ice-headline-big">High-purity reagents, volumetric glassware, filtration media, and daily lab supplies for routine analysis.</p>
    </div>
  </section>

  <!-- ─── CATEGORIES ─── -->
  <section class="ice-cat-section" id="range" data-view>
    <div class="ice-cat-head">
      <span class="ice-cat-overline">Consumable Categories</span>
      <h2 class="ice-cat-title">Find your consumables</h2>
    </div>
    <div class="ice-cat-grid">
      {categoryCards.map((card) => (
        <a href={card.href} class="ice-cat-card">
          <span class="ice-cat-media">
            <img src={card.image} alt={card.name} loading="lazy" decoding="async" />
          </span>
          <span class="ice-cat-meta">
            <span class="ice-cat-name">{card.name}</span>
            <span class="ice-cat-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── HIGHLIGHT ─── -->
  <section class="ice-highlight" data-view>
    <div class="ice-highlight-image clip--top_left">
      <img src="/consumables-highlight.jpg" alt="Laboratory consumables" loading="lazy" />
    </div>
    <div class="ice-highlight-overlay">
      <h2>Complete Laboratory Consumables Range</h2>
      <div class="ice-hero-buttons">
        <a href="#glassware" class="ice-btn ice-btn-outlined"><span>View All Consumables</span></a>
        <a href="/contact" class="ice-btn ice-btn-outlined"><span>Request Bulk Pricing</span></a>
      </div>
    </div>
  </section>

  <!-- ─── PRODUCT SECTIONS (grid) ─── -->
  {gridSections.map(section => (
    <section class="ice-grid-section" id={section.id} data-view>
      <div class="ice-grid-head">
        <h2>{section.title}</h2>
      </div>
      <p class="ice-slider-sub">{section.sub}</p>
      <div class="ice-grid">
        {section.cards.map((card) => (
          <div class="ice-grid-card">
            <span class="ice-grid-label">{card.label}</span>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- ─── CONTACT CTA ─── -->
  <section class="ice-cta" data-view>
    <h2>Stock your laboratory?</h2>
    <p>Tell us what you use regularly and we&#39;ll set up a reliable, cost-effective supply.</p>
    <a href="/contact" class="ice-btn ice-btn-white"><span>Get in touch</span></a>
  </section>

</div>

</Layout>

<style>
  .ice-page {
    --ice-pad: 24px;
    --ice-black: #262626;
    --ice-white: #ffffff;
    --ice-border: #ececec;
    --ice-image-bg: #ececec;
    --ice-sans: var(--font-sans);
    --ice-mono: var(--font-mono);
    --ice-opacity: 0.35;
    --ice-underline-offset: 0.3em;
    --ice-btn-height: 32px;
    --ice-page-gap: 120px;
    --ice-header-height: 52px;
    background: var(--ice-white);
    color: var(--ice-black);
    font-size: 10px;
    flex-direction: column;
    gap: var(--ice-page-gap);
    display: flex;
  }
  @media (max-width: 1024px) {
    .ice-page { --ice-page-gap: 72px; }
  }

  /* ─── BUTTONS ─── */
  .ice-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    background: var(--ice-black);
    color: var(--ice-white);
    height: var(--ice-btn-height);
    padding: 0 36px;
    border: 1px solid var(--ice-black);
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  @media (max-width: 1024px) {
    .ice-btn { padding: 0 28px; }
  }
  .ice-btn span { pointer-events: none; }

  .ice-btn-white {
    background: var(--ice-white);
    color: var(--ice-black);
    border-color: var(--ice-white);
  }

  .ice-btn-outlined {
    background: transparent;
    color: var(--ice-white);
    border-color: rgba(255, 255, 255, 0.5);
    padding: 0 12px;
  }

  .ice-cta .ice-btn-white {
    background: #1a365d;
    color: var(--ice-white);
    border-color: #1a365d;
  }

  .ice-cta .ice-btn-white:hover {
    background: var(--ice-white) !important;
    color: #1a365d !important;
    border-color: #1a365d !important;
  }

  @media (hover: hover) {
    .ice-btn:hover {
      background: rgba(38, 38, 38, 0.9);
      color: var(--ice-white);
      border-color: rgba(38, 38, 38, 0.9);
    }
    .ice-btn-white:hover {
      background: var(--ice-black);
      color: var(--ice-white);
      border-color: var(--ice-black);
    }
    .ice-btn-outlined:hover {
      border-color: var(--ice-white);
      background: transparent;
    }
  }

  /* ─── HERO ─── */
  .ice-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
  }
  .ice-hero-image {
    height: 100svh;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .ice-hero-image:after {
    content: "";
    pointer-events: none;
    background:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch' seed='12'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.06'/%3E%3C/svg%3E"),
      linear-gradient(180deg, #00000040 0%, #0000001a 45%, #0000008c 78%, #000000cc 100%),
      linear-gradient(90deg, #00000099 0%, #00000059 35%, #00000000 70%);
    position: absolute;
    inset: 0;
  }
  .ice-hero-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-hero-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 150px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-hero-overlay h1 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-hero-overlay h1 {
      letter-spacing: -0.02em;
      font-size: 88px;
      line-height: 0.9;
      max-width: 55%;
    }
    .ice-hero-overlay { padding-bottom: 76px; }
  }
  .ice-hero-buttons {
    flex-flow: wrap;
    gap: 12px;
    display: flex;
  }

  /* ─── HERO TRUST ─── */
  .ice-hero-trust {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 14px var(--ice-pad);
    flex-flow: wrap;
    gap: 8px 48px;
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    display: flex;
    background: linear-gradient(#0000, #0009 100%);
  }
  .ice-hero-trust p {
    margin: 0;
    opacity: 0.8;
    color: var(--ice-white);
    position: relative;
  }
  .ice-hero-trust p + p:before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ice-white);
    opacity: 0.45;
    position: absolute;
    left: -24px;
    top: 50%;
    transform: translateY(-50%);
  }

  /* ─── CATEGORIES ─── */
  .ice-cat-section {
    padding: 0 var(--ice-pad);
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
    border-top: 1px solid var(--ice-border);
    padding-top: 24px;
  }
  .ice-cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 24px;
    margin-bottom: 28px;
  }
  .ice-cat-overline {
    font-family: var(--ice-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(38, 38, 38, 0.55);
  }
  .ice-cat-title {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 500;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-cat-title {
      font-size: 24px;
    }
  }
  .ice-cat-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    display: grid;
  }
  @media (min-width: 768px) {
    .ice-cat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 1024px) {
    .ice-cat-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--ice-pad);
    }
  }
  .ice-cat-card {
    flex-direction: column;
    text-decoration: none !important;
    color: inherit;
    background: var(--ice-white);
    border: 1px solid var(--ice-border);
    border-radius: var(--radius-sm);
    min-width: 0;
    display: flex;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .ice-cat-media {
    aspect-ratio: 4 / 3;
    background: var(--ice-image-bg);
    overflow: hidden;
    display: block;
    position: relative;
  }
  .ice-cat-media img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    display: block;
    padding: 16px;
    background: var(--ice-white);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ice-cat-meta {
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 16px 18px;
    display: flex;
    background: var(--ice-white);
  }
  .ice-cat-name {
    font-family: var(--ice-sans);
    font-size: 13.5px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: var(--ice-black);
    text-decoration: none !important;
    transition: color 0.2s ease;
  }
  .ice-cat-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  .ice-cat-arrow svg {
    width: 16px;
    height: 16px;
  }
  @media (hover: hover) {
    .ice-cat-card:hover {
      border-color: #cbd5e1 !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.06);
      text-decoration: none !important;
    }
    .ice-cat-card:hover .ice-cat-media img {
      transform: scale(1.03);
    }
    .ice-cat-card:hover .ice-cat-name {
      color: #1a365d !important;
      text-decoration: none !important;
    }
    .ice-cat-card:hover .ice-cat-arrow {
      color: #1a365d !important;
      transform: translateX(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ice-cat-card,
    .ice-cat-media img,
    .ice-cat-name,
    .ice-cat-arrow {
      transition: none;
    }
  }

  /* ─── HEADLINE TEXT ─── */
  .ice-headline-text {
    text-align: center;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 0 var(--ice-pad);
    display: flex;
  }
  .ice-headline-footer {
    color: #1a365d;
  }
  .ice-headline-wrapper {
    text-align: center;
    max-width: 1000px;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    margin: 0 auto;
  }
  .ice-headline-big {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ice-headline-big {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  /* ─── HIGHLIGHT ─── */
  .ice-highlight {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .ice-highlight-image {
    aspect-ratio: 2;
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  @media (max-width: 1024px) {
    .ice-highlight-image {
      height: calc(100svh - var(--ice-header-height));
      aspect-ratio: auto;
    }
  }
  .ice-highlight-image:after {
    content: "";
    pointer-events: none;
    background:
      linear-gradient(180deg, #00000099 0%, #0000004d 40%, #00000059 60%, #000000e6 100%),
      linear-gradient(90deg, #1a365d99 0%, #1a365d33 45%, #00000000 70%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='5' numOctaves='4' stitchTiles='stitch' seed='12'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.14'/%3E%3C/svg%3E");
    position: absolute;
    inset: 0;
  }
  .ice-highlight-image img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }
  .ice-highlight-overlay {
    padding-left: var(--ice-pad);
    color: var(--ice-white);
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: 56px;
    display: flex;
    position: absolute;
    inset: 0;
  }
  .ice-highlight-overlay h2 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 44px;
    line-height: 1;
    font-weight: 600;
    margin: 0 0 25px;
  }
  @media (min-width: 1024px) {
    .ice-highlight-overlay h2 {
      letter-spacing: -0.01em;
      font-size: 56px;
      line-height: 1.05;
      max-width: 65%;
    }
  }

  /* ─── GRID SECTIONS ─── */
  .ice-grid-section {
    padding: 0 var(--ice-pad);
    scroll-margin-top: calc(var(--ice-header-height) + 24px);
  }
  .ice-grid-head {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    padding-bottom: 17px;
    font-size: 12px;
    line-height: 1.4;
  }
  .ice-grid-head h2 {
    font-size: inherit;
    font-weight: 400;
    margin: 0;
  }
  .ice-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    display: grid;
  }
  @media (min-width: 768px) {
    .ice-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--ice-pad);
    }
  }
  @media (min-width: 1024px) {
    .ice-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--ice-pad);
    }
  }
  .ice-grid-card {
    border: 1px solid var(--ice-border);
    padding: var(--ice-pad);
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    display: flex;
    text-decoration: none;
    color: inherit;
  }
  .ice-grid-label {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: 12px;
    line-height: 1.4;
  }
  .ice-grid-card p {
    font-family: var(--ice-sans);
    font-size: 15px;
    line-height: 1.4;
    margin: 0;
    opacity: 0.75;
  }

  /* ─── SLIDER SUBTITLE ─── */
  .ice-slider-sub {
    font-family: var(--ice-mono);
    letter-spacing: 0.01em;
    font-size: 12px;
    line-height: 1.5;
    margin: 0;
    padding: 0 var(--ice-pad) 20px;
    opacity: 0.65;
    max-width: 62ch;
  }

  /* ─── CONTACT CTA ─── */
  .ice-cta {
    background: #fff;
    color: #1a365d;
    min-height: 100svh;
    justify-content: center;
    padding: 80px var(--ice-pad);
    text-align: center;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    position: relative;
    z-index: 1;
  }
  .ice-cta h2 {
    font-family: var(--ice-sans);
    letter-spacing: -0.01em;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
    max-width: 20ch;
  }
  .ice-cta p {
    font-family: var(--ice-sans);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
    max-width: 44ch;
  }
  @media (min-width: 1024px) {
    .ice-cta {
      gap: 30px;
    }
    .ice-cta h2 {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }

  @media (max-width: 480px) {
    .ice-page { --ice-pad: 16px; }
    .ice-hero-overlay h1 { font-size: 34px; }
    .ice-hero-overlay { padding-bottom: 96px; }
    .ice-hero-trust { gap: 6px 20px; }
    .ice-hero-trust p + p:before { left: -10px; }
    .ice-highlight-overlay h2 { font-size: 32px; }
  }
</style>
