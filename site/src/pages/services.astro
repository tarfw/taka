---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" hasHero={true} headerSolid={true}>
  <section class="page-hero" data-view>
    <div class="container">
      <span class="eyebrow t--fade">Services</span>
      <h1 class="page-hero-title" data-splitting="words">Delivery, installation<br><em>and</em> support.</h1>
      <p class="page-hero-sub t--fade t--delay_200">We handle the complete process — from product selection to on-site installation and ongoing maintenance.</p>
    </div>
  </section>

  <section class="section" data-view>
    <div class="container">
      <div class="services-grid">
        <div class="service-card t--fade t--delay_100">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3 class="service-title">Delivery & logistics</h3>
          <p class="service-desc">We coordinate safe delivery of furniture and equipment across all seven emirates. Our logistics team handles scheduling, transport, and site access coordination.</p>
        </div>
        <div class="service-card t--fade t--delay_250">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="service-title">Installation</h3>
          <p class="service-desc">Our trained technicians install laboratory furniture, fume hoods, workbenches, and scientific equipment to manufacturer specifications and safety standards.</p>
        </div>
        <div class="service-card t--fade t--delay_400">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="service-title">Quality assurance</h3>
          <p class="service-desc">Every product we supply is inspected for quality and compliance. We ensure all equipment meets relevant UAE and international standards.</p>
        </div>
        <div class="service-card t--fade t--delay_550">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3 class="service-title">After-sales support</h3>
          <p class="service-desc">We provide ongoing support for all products — from spare parts and accessories to maintenance guidance and warranty service.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider container"></div>

  <section class="section" data-view>
    <div class="container">
      <div class="process-grid">
        <div class="process-left">
          <span class="eyebrow">Project Lifecycle</span>
          <h2 class="section-title">From initial specs to site handover.</h2>
          <p class="section-subtitle">A structured 4-phase delivery model ensuring compliance, site safety, and seamless commissioning for UAE facilities.</p>
        </div>
        <div class="process-right">
          <div class="workflow-timeline">
            <div class="workflow-step">
              <div class="workflow-badge">Phase 1</div>
              <div class="workflow-body">
                <h4 class="workflow-title">Technical Needs & Site Survey</h4>
                <p class="workflow-desc">We evaluate your laboratory layout, utility connections (gas, electrical, exhaust), budget targets, and required ISO/EN certification standards.</p>
              </div>
            </div>
            <div class="workflow-step">
              <div class="workflow-badge">Phase 2</div>
              <div class="workflow-body">
                <h4 class="workflow-title">Specification & Commercial Proposal</h4>
                <p class="workflow-desc">Receive a transparent itemized quotation detailing manufacturer warranties, technical datasheets, origin certificates, and delivery schedules.</p>
              </div>
            </div>
            <div class="workflow-step">
              <div class="workflow-badge">Phase 3</div>
              <div class="workflow-body">
                <h4 class="workflow-title">Staged Logistics & Freight Handling</h4>
                <p class="workflow-desc">Equipment and furniture are shipped, custom-cleared, and delivered directly to your site across the UAE using dedicated freight transport.</p>
              </div>
            </div>
            <div class="workflow-step">
              <div class="workflow-badge">Phase 4</div>
              <div class="workflow-body">
                <h4 class="workflow-title">Fit-out, Commissioning & Handover</h4>
                <p class="workflow-desc">Our certified field technicians assemble furniture, connect fume hood exhaust systems, calibrate apparatus, and train your facility staff.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ice-cta" data-view>
    <h2>Need service or support?</h2>
    <p>Our team is ready to help. Reach out and we'll respond within the working day.</p>
    <a href="/contact" class="ice-btn ice-btn-white"><span>Contact us</span></a>
  </section>
</Layout>

<style>
  .page-hero {
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    background: #fff;
    position: relative;
  }
  .page-hero .container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: 3.5rem;
  }
  .page-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .page-hero-title em {
    font-style: italic;
    color: var(--color-text-secondary);
  }
  .page-hero-sub {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .service-card {
    background: #fff;
    padding: 2rem 1.5rem;
  }
  .service-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .service-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .service-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .process-left {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
  }
  .workflow-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    padding-left: 0.5rem;
  }
  .workflow-step {
    position: relative;
    background: #fafafa;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    transition: border-color 0.2s ease;
  }
  .workflow-step:hover {
    border-color: #cbd5e1;
  }
  .workflow-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #1a365d;
    color: #fff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .workflow-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
  .workflow-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  @media (max-width: 768px) {
    .page-hero .container { padding-bottom: 2.5rem; }
    .page-hero-title { font-size: 2rem; }
    .services-grid { grid-template-columns: 1fr; }
    .process-grid { grid-template-columns: 1fr; gap: 2rem; }
    .process-left { position: static; }
  }
/* ═══ CONTACT CTA — ice-cta design (matches analytical) ═══ */
  .ice-cta {
    --ice-pad: 24px;
    background: #fff;
    color: #1a365d;
    min-height: 100svh;
    justify-content: center;
    padding: 80px var(--ice-pad);
    text-align: center;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    display: flex;
    position: relative;
    z-index: 1;
  }
  .ice-cta h2 {
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
    max-width: 20ch;
  }
  .ice-cta p {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
    max-width: 44ch;
  }
  .ice-cta .ice-btn,
  .ice-cta .ice-btn:hover {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    height: 32px;
    padding: 0 36px;
    border: 1px solid #1a365d;
    background: #1a365d;
    color: #ffffff;
    font-size: 12px;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease-out, color 0.1s ease-out, border-color 0.1s ease-out;
  }
  .ice-cta .ice-btn:hover {
    background: #ffffff;
    color: #1a365d;
  }
  .ice-cta .ice-btn span { pointer-events: none; }
  @media (min-width: 1024px) {
    .ice-cta { gap: 30px; }
    .ice-cta h2 {
      letter-spacing: -0.02em;
      font-size: 64px;
      line-height: 1.05;
    }
  }
  @media (max-width: 480px) {
    .ice-cta { --ice-pad: 16px; }
  }
</style>
