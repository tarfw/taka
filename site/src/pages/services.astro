---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" hasHero={true} headerSolid={true}>
  <section class="page-hero" data-view>
    <div class="container">
      <span class="eyebrow t--fade">Services</span>
      <h1 class="page-hero-title" data-splitting="words">Delivery, installation<br><em>and</em> support.</h1>
      <p class="page-hero-sub t--fade t--delay_200">We handle the complete process — from product selection to on-site installation and ongoing maintenance.</p>
    </div>
  </section>

  <section class="section" data-view>
    <div class="container">
      <div class="services-grid">
        <div class="service-card t--fade t--delay_100">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3 class="service-title">Delivery & logistics</h3>
          <p class="service-desc">We coordinate safe delivery of furniture and equipment across all seven emirates. Our logistics team handles scheduling, transport, and site access coordination.</p>
        </div>
        <div class="service-card t--fade t--delay_250">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="service-title">Installation</h3>
          <p class="service-desc">Our trained technicians install laboratory furniture, fume hoods, workbenches, and scientific equipment to manufacturer specifications and safety standards.</p>
        </div>
        <div class="service-card t--fade t--delay_400">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="service-title">Quality assurance</h3>
          <p class="service-desc">Every product we supply is inspected for quality and compliance. We ensure all equipment meets relevant UAE and international standards.</p>
        </div>
        <div class="service-card t--fade t--delay_550">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3 class="service-title">After-sales support</h3>
          <p class="service-desc">We provide ongoing support for all products — from spare parts and accessories to maintenance guidance and warranty service.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider container"></div>

  <section class="section" data-view>
    <div class="container">
      <div class="process-grid">
        <div class="process-left">
          <span class="eyebrow t--fade">How it works</span>
          <h2 class="section-title t--fadedown t--delay_200">From inquiry<br>to installation.</h2>
        </div>
        <div class="process-right">
          <div class="process-step t--fade t--delay_100">
            <span class="process-number">01</span>
            <div>
              <h4 class="process-title">Consultation</h4>
              <p class="process-desc">Tell us about your facility, requirements, and budget. We'll recommend the right products.</p>
            </div>
          </div>
          <div class="process-step t--fade t--delay_250">
            <span class="process-number">02</span>
            <div>
              <h4 class="process-title">Quote & selection</h4>
              <p class="process-desc">We provide a detailed quote with product specifications, pricing, and delivery timelines.</p>
            </div>
          </div>
          <div class="process-step t--fade t--delay_400">
            <span class="process-number">03</span>
            <div>
              <h4 class="process-title">Delivery</h4>
              <p class="process-desc">We coordinate delivery to your site across the UAE, with scheduling that minimizes disruption.</p>
            </div>
          </div>
          <div class="process-step t--fade t--delay_550">
            <span class="process-number">04</span>
            <div>
              <h4 class="process-title">Installation</h4>
              <p class="process-desc">Our technicians install and set up all equipment, ensuring everything works correctly.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section" data-view>
    <div class="container text-center">
      <h2 class="section-title t--fadedown">Need service or support?</h2>
      <p class="section-subtitle t--fade t--delay_200" style="margin-left: auto; margin-right: auto;">Our team is ready to help. Reach out and we'll respond within the working day.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem;">
        <a href="/contact" class="btn btn-dark t--fade t--delay_300">Contact us</a>
        <a href="javascript:void(0)" target="_blank" class="btn btn-outline t--fade t--delay_500">WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    background: #fff;
    position: relative;
  }
  .page-hero .container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: 3.5rem;
  }
  .page-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .page-hero-title em {
    font-style: italic;
    color: var(--color-text-secondary);
  }
  .page-hero-sub {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .service-card {
    background: #fff;
    padding: 2rem 1.5rem;
  }
  .service-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .service-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  .service-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .process-left {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
  }
  .process-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .process-step {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .process-step:last-child { border-bottom: none; padding-bottom: 0; }
  .process-number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    padding-top: 0.15rem;
  }
  .process-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }
  .process-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  @media (max-width: 768px) {
    .page-hero .container { padding-bottom: 2.5rem; }
    .page-hero-title { font-size: 2rem; }
    .services-grid { grid-template-columns: 1fr; }
    .process-grid { grid-template-columns: 1fr; gap: 2rem; }
    .process-left { position: static; }
  }
</style>
