---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">

  <!-- HERO — exact exa.ai style -->
  <section class="hero-container">
    <video class="hero-video" autoplay muted loop playsinline>
      <source src="/bg2.mp4" type="video/mp4" />
    </video>
    <div class="hero-content-motion">
      <div class="hero-text">
        <h1 class="hero-title">
          Scientific equipment<br class="hidden sm:block" />
          &amp; lab furniture,<br class="hidden sm:block" />
          delivered &amp; installed.
        </h1>
        <p class="hero-subtitle">
          One supplier for schools, hospitals, laboratories, and factories across the UAE.
        </p>
        <div class="hero-actions">
          <a href="/catalogue" class="hero-btn-primary">Browse products</a>
        </div>
      </div>
      <!-- Search box -->
      <div class="hero-search-wrapper">
        <div class="hero-search-box">
          <input type="text" class="hero-search-input" placeholder="Find lab furniture, testing apparatus..." />
          <button class="hero-search-submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
          </button>
        </div>
      </div>
      <!-- Logo strip -->
      <div class="hero-logos">
        <div class="hero-logos-track">
          <span class="hero-logo-item">Abu Dhabi Education Council</span>
          <span class="hero-logo-item">Sheikh Khalifa Medical City</span>
          <span class="hero-logo-item">Khalifa University</span>
          <span class="hero-logo-item">SEHA</span>
          <span class="hero-logo-item">Abu Dhabi Police</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE SUPPLY -->
  <section class="section">
    <div class="container">
      <div class="supply-grid">
        <div class="supply-card">
          <div class="supply-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
          </div>
          <h3 class="supply-title">Schools & Hospitals</h3>
          <p class="supply-desc">Classroom furniture, hospital beds, medical carts, and institutional equipment designed for durability and hygiene.</p>
        </div>
        <div class="supply-card">
          <div class="supply-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
          </div>
          <h3 class="supply-title">Scientific Equipment</h3>
          <p class="supply-desc">Practical devices, measuring instruments, and scientific apparatus for research institutions and laboratories.</p>
        </div>
        <div class="supply-card">
          <div class="supply-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="supply-title">Testing & Commissioning</h3>
          <p class="supply-desc">Testing equipment, calibration apparatus, and commissioning tools for quality assurance and compliance.</p>
        </div>
        <div class="supply-card">
          <div class="supply-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8L8 13V8L2 12z"/></svg>
          </div>
          <h3 class="supply-title">Laboratory & Factory</h3>
          <p class="supply-desc">Workbenches, storage solutions, fume hoods, and industrial furniture for laboratories and manufacturing facilities.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><div class="rule"></div></div>

  <!-- BUILT FOR EVERY SECTOR -->
  <section class="sector-section">
    <div class="sector-wrap">
      <div class="sector-left">
        <h2 class="sector-heading">Built for every<br />sector</h2>
        <p class="sector-desc">One supplier for schools, hospitals, labs, and factories across the UAE.</p>
        <div class="sector-list">
          <button class="sector-item active" data-sector="education">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            Education &amp; Schools
          </button>
          <button class="sector-item" data-sector="healthcare">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M12 14v4"/><path d="M10 16h4"/></svg>
            </span>
            Healthcare &amp; Hospitals
          </button>
          <button class="sector-item" data-sector="research">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
            </span>
            Research Laboratories
          </button>
          <button class="sector-item" data-sector="industrial">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            Industrial &amp; Factory
          </button>
        </div>
      </div>
      <div class="sector-right">
        <div class="sector-panel">
          <div id="sector-result">
            <h3 class="sector-result-title">Education &amp; Schools</h3>
            <p class="sector-result-subtitle">Equipping classrooms and school laboratories across the UAE</p>
            <div class="sector-result-tag">Key Products</div>
            <div class="sector-result-list">
              <div class="sector-product">
                <p class="sector-product-name">Laboratory Workstations</p>
                <p class="sector-product-desc">Modular bench systems with chemical-resistant tops</p>
              </div>
              <div class="sector-product">
                <p class="sector-product-name">Fume Hoods</p>
                <p class="sector-product-desc">Ducted and ductless models, EN 14175 certified</p>
              </div>
              <div class="sector-product">
                <p class="sector-product-name">Student Desks &amp; Seating</p>
                <p class="sector-product-desc">Adjustable-height lab desks, powder-coated steel frames</p>
              </div>
              <div class="sector-product">
                <p class="sector-product-name">Safety Cabinets</p>
                <p class="sector-product-desc">Eye-wash stations, fire extinguishers, first-aid kits</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const sectorData = {
      education: {
        title: "Education & Schools",
        subtitle: "Equipping classrooms and school laboratories across the UAE",
        products: [
          { name: "Laboratory Workstations", detail: "Modular bench systems with chemical-resistant tops" },
          { name: "Fume Hoods", detail: "Ducted and ductless models, EN 14175 certified" },
          { name: "Student Desks & Seating", detail: "Adjustable-height lab desks, powder-coated steel frames" },
          { name: "Safety Cabinets", detail: "Eye-wash stations, fire extinguishers, first-aid kits" }
        ]
      },
      healthcare: {
        title: "Healthcare & Hospitals",
        subtitle: "Medical furniture and equipment for healthcare facilities",
        products: [
          { name: "Hospital Beds", detail: "Electric and manual models with side rails" },
          { name: "Medical Carts", detail: "Crash carts, procedure carts, IV poles, stainless steel" },
          { name: "Sterile Storage Cabinets", detail: "Laminar flow cabinets and clean-room shelving" },
          { name: "Examination Tables", detail: "Adjustable height, vinyl upholstery" }
        ]
      },
      research: {
        title: "Research Laboratories",
        subtitle: "Precision equipment for research institutions",
        products: [
          { name: "Analytical Instruments", detail: "Spectrophotometers, balances, centrifuges" },
          { name: "ESD Workbenches", detail: "Anti-static surfaces for electronics labs" },
          { name: "Chemical Storage", detail: "Flammable cabinets, corrosive storage, EN 14470 certified" },
          { name: "Fume Extraction", detail: "Bench-top and ceiling-mounted systems" }
        ]
      },
      industrial: {
        title: "Industrial & Factory",
        subtitle: "Testing and workspace solutions for manufacturing",
        products: [
          { name: "Testing Equipment", detail: "Tensile testers, hardness testers, gauges" },
          { name: "Heavy-Duty Workbenches", detail: "Steel-frame benches with 500kg load capacity" },
          { name: "Calibration Tools", detail: "Reference standards and calibration kits" },
          { name: "Tool Storage", detail: "Industrial cabinets, shadow boards" }
        ]
      }
    };

    document.querySelectorAll('.sector-item').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sector-item').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const key = btn.dataset.sector;
        const data = sectorData[key];
        const result = document.getElementById('sector-result');
        result.querySelector('.sector-result-title').textContent = data.title;
        result.querySelector('.sector-result-subtitle').textContent = data.subtitle;
        const list = result.querySelector('.sector-result-list');
        list.innerHTML = data.products.map(p => `
          <div class="sector-product">
            <p class="sector-product-name">${p.name}</p>
            <p class="sector-product-desc">${p.detail}</p>
          </div>
        `).join('');
      });
    });
  </script>

  <!-- TRUSTED BY — exact exa.ai style -->
  <section class="trusted-section">
    <div class="trusted-wrap">
      <div class="trusted-header">
        <h2 class="trusted-heading">Trusted by leading institutions<br class="hidden sm:block" /> across the UAE</h2>
        <a href="/contact" class="trusted-btn">View all case studies</a>
      </div>

      <!-- Main testimonial card -->
      <div class="trusted-main">
        <div class="trusted-main-inner">
          <!-- Image side -->
          <div class="trusted-main-image">
            <div class="trusted-main-placeholder">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div class="trusted-main-overlay">
              <span class="trusted-main-play">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><circle cx="7.5" cy="7.5" r="6.5" stroke="currentColor" stroke-width="1.25"></circle><path d="M6 4.75L11 7.5L6 10.25V4.75Z" fill="currentColor"></path></svg>
                <span>Watch Video</span>
              </span>
            </div>
          </div>
          <!-- Quote side -->
          <div class="trusted-main-content">
            <div class="trusted-main-logo">Abu Dhabi Education Council</div>
            <blockquote class="trusted-main-quote">
              "TAKA delivered and installed laboratory workstations across multiple schools. Professional service from start to finish."
            </blockquote>
            <div class="trusted-main-author">
              <p class="trusted-main-name">Ahmed Al Mansouri</p>
              <p class="trusted-main-role">Facilities Director</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom cards -->
      <div class="trusted-bottom">
        <!-- Stats card -->
        <a href="/contact" class="trusted-stats-card">
          <div class="trusted-stats-logo">Sheikh Khalifa Medical City</div>
          <div class="trusted-stats-content">
            <div class="trusted-stats-item">
              <span class="trusted-stats-number">25+</span>
              <span class="trusted-stats-label">Projects completed</span>
            </div>
            <div class="trusted-stats-item">
              <span class="trusted-stats-number">10+</span>
              <span class="trusted-stats-label">Institutions served</span>
            </div>
          </div>
          <span class="trusted-stats-cta">Read case study</span>
        </a>

        <!-- Image card -->
        <div class="trusted-image-card">
          <div class="trusted-image-bg"></div>
          <div class="trusted-image-content">
            <div class="trusted-image-logo">Khalifa University</div>
            <div class="trusted-image-bottom">
              <p class="trusted-image-text">Equipping research labs with modern scientific apparatus</p>
              <span class="trusted-image-cta">Read case study</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST & COMPLIANCE — exa.ai dark style -->
  <section class="trust-section">
    <div class="trust-wrap">
      <div class="trust-header">
        <h2 class="trust-heading">Quality standards<br />and compliance</h2>
        <a href="/contact" class="trust-btn">Talk to an expert &rarr;</a>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-features">
        <div class="trust-feature">
          <h3 class="trust-feature-title">ISO 9001 Certified</h3>
          <p class="trust-feature-desc">Our quality management system meets international standards. Consistent product quality and reliable supply chain processes for every order.</p>
        </div>
        <div class="trust-feature">
          <h3 class="trust-feature-title">Authorized Distributor</h3>
          <p class="trust-feature-desc">Official partnerships with leading scientific equipment manufacturers. Genuine products with full manufacturer warranties and support.</p>
        </div>
        <div class="trust-feature">
          <h3 class="trust-feature-title">Calibration &amp; Documentation</h3>
          <p class="trust-feature-desc">Complete compliance documentation and calibration certificates for regulated laboratory environments. Full traceability for every instrument.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT CTA — exa.ai large serif style -->
  <section class="cta-section">
    <div class="cta-content">
      <h2 class="cta-heading">Ready to equip<br>your facility?</h2>
      <p class="cta-subtitle">Tell us your requirements and we'll provide a tailored quote within the working day.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-dark">Request a quote</a>
        <a href="/catalogue" class="btn btn-ghost">Browse products</a>
      </div>
    </div>
  </section>

</Layout>
