  <section class="ice-editorial" aria-label="Our story">
    <div class="ice-editorial-image">
      <img src="/anbg2.jpg" alt="TAKA Scientific analytical laboratory" loading="lazy" />
    </div>
    <div class="ice-editorial-overlay">
      <div class="ice-editorial-text">
        <h2 class="ice-editorial-title">We&#39;re in it for the long run &mdash; and so is our instrumentation.</h2>
        <p class="ice-editorial-text-p">While most suppliers put the margin first, TAKA puts our customers, our people and our partners first — with instruments that keep running, year after year.</p>
        <a href="/about" class="ice-btn ice-btn-outlined"><span>Our story</span></a>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY — exact exa.ai style -->
  <section class="trusted-section">
    <div class="trusted-wrap">
      <div class="trusted-header">
        <h2 class="trusted-heading">Trusted by leading institutions<br class="hidden sm:block" /> across the UAE</h2>
        <a href="/case-studies" class="trusted-btn">View all case studies</a>
      </div>

      <!-- Main testimonial card -->
      <a href="/case-studies/abu-dhabi-education-council" class="trusted-main">
        <div class="trusted-main-inner">
          <!-- Image side -->
          <div class="trusted-main-image">
            <img src="/case-studies/adec-school-lab.jpg" alt="Student in a school science laboratory" class="trusted-main-img" loading="lazy" />
          </div>
          <!-- Quote side -->
          <div class="trusted-main-content">
            <div class="trusted-main-logo">Abu Dhabi Education Council</div>
            <blockquote class="trusted-main-quote">
              "TAKA delivered and installed laboratory workstations across multiple schools. Professional service from start to finish."
            </blockquote>
            <div class="trusted-main-author">
              <p class="trusted-main-name">Ahmed Al Mansouri</p>
              <p class="trusted-main-role">Facilities Director</p>
            </div>
          </div>
        </div>
      </a>

      <!-- Bottom cards -->
      <div class="trusted-bottom">
        <!-- Stats card -->
        <a href="/case-studies/sheikh-khalifa-medical-city" class="trusted-stats-card">
          <div class="trusted-stats-logo">Sheikh Khalifa Medical City</div>
          <div class="trusted-stats-content">
            <div class="trusted-stats-item">
              <span class="trusted-stats-number">25+</span>
              <span class="trusted-stats-label">Projects completed</span>
            </div>
            <div class="trusted-stats-item">
              <span class="trusted-stats-number">10+</span>
              <span class="trusted-stats-label">Institutions served</span>
            </div>
          </div>
          <span class="trusted-stats-cta">Read case study</span>
        </a>

        <!-- Image card -->
        <a href="/case-studies/khalifa-university" class="trusted-image-card">
          <div class="trusted-image-bg"></div>
          <div class="trusted-image-content">            <div class="trusted-image-logo">Khalifa University</div>
            <div class="trusted-image-bottom">
              <p class="trusted-image-text">Equipping research labs with modern scientific apparatus</p>
              <span class="trusted-image-cta">Read case study</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST & COMPLIANCE — exa.ai dark style -->
  <section class="trust-section">
    <div class="trust-wrap">
      <div class="trust-header">
        <h2 class="trust-heading">Quality standards<br />and compliance</h2>
        <a href="/contact" class="trust-btn">Talk to our team &rarr;</a>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badges">
        <div class="trust-badge trust-badge-featured">
          <span class="trust-badge-icon trust-badge-icv">
            <img src="/icv.avif" alt="ICV logo" width="200" height="200" />
          </span>
          <div class="trust-badge-text">
            <span class="trust-badge-name">ICV</span>
            <span class="trust-badge-desc">In-Country Value</span>
          </div>
        </div>
        <div class="trust-col-right">
          <div class="trust-iso-row">
            <div class="trust-badge">
              <span class="trust-badge-icon trust-badge-iso">
                <img src="/ISO-Logo-500x313.png" alt="ISO 9001 logo" width="56" height="56" />
              </span>
              <div class="trust-badge-text">
                <span class="trust-badge-name">ISO 9001</span>
                <span class="trust-badge-desc">Quality Management</span>
              </div>
            </div>
            <div class="trust-badge">
              <span class="trust-badge-icon trust-badge-iso">
                <img src="/ISO-Logo-500x313.png" alt="ISO 14001 logo" width="56" height="56" />
              </span>
              <div class="trust-badge-text">
                <span class="trust-badge-name">ISO 14001</span>
                <span class="trust-badge-desc">Environmental</span>
              </div>
            </div>
            <div class="trust-badge">
              <span class="trust-badge-icon trust-badge-iso">
                <img src="/ISO-Logo-500x313.png" alt="ISO 45001 logo" width="56" height="56" />
              </span>
              <div class="trust-badge-text">
                <span class="trust-badge-name">ISO 45001</span>
                <span class="trust-badge-desc">Health &amp; Safety</span>
              </div>
            </div>
          </div>
          <div class="trust-features">
