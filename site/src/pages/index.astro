---
import Layout from '../layouts/Layout.astro';
import productData from '../data/products.json';

const supplyCards = [
  {
    id: 'analytical-equipments',
    name: 'Analytical Equipments',
    desc: 'GC, spectroscopy and precision instruments for chemical analysis.',
    icon: '<path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>',
  },
  {
    id: 'scientific-equipments',
    name: 'Scientific Equipments',
    desc: 'Instruments and apparatus for sample preparation and lab research.',
    icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M12 14v4"/><path d="M10 16h4"/>',
  },
  {
    id: 'testing-apparatus',
    name: 'Testing Apparatus',
    desc: 'QC, testing and calibration equipment for quality assurance.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    id: 'laboratory-furnitures',
    name: 'Laboratory Furnitures',
    desc: 'Workbenches, fume hoods and lab furniture built for durability.',
    icon: '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8L8 13V8L2 12z"/>',
  },
  {
    id: 'laboratory-consumables',
    name: 'Laboratory Consumables',
    desc: 'Glassware, reagents and everyday supplies for every lab.',
    icon: '<path d="M10 2v6.292a.5.5 0 0 1-.2.4L3 14v2c0 3.5 3.5 6 9 6s9-2.5 9-6v-2l-6.8-5.308a.5.5 0 0 1-.2-.4V2"/><path d="M8.5 15h7"/><path d="M12 15v3"/>',
  },
  {
    id: 'turnkey',
    name: 'Turnkey Projects',
    desc: 'Complete lab design, supply, installation and commissioning.',
    icon: '<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  },
];

const categoryItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: supplyCards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: new URL(`/catalogue/${c.id}`, Astro.site ?? 'https://taka.ae').href,
  })),
};
---

<Layout title="Home">

  <!-- HERO — Cantor8-inspired layout with chemical atom canvas -->
  <section class="hero-container">
    <div class="hero-bg" style="background-image: url('/bg3.jpg');"></div>

    <!-- Chemical atom canvas visualization -->
    <div class="hero-canvas-wrap">
      <canvas id="atom-canvas"></canvas>
    </div>

    <div class="hero-content">
      <div class="hero-text-block">
        <h1 class="hero-title">Scientific equipment &amp; lab furniture, delivered &amp; installed across the UAE.</h1>
        <p class="hero-subtitle">TAKA Scientific supplies analytical instruments, testing apparatus, laboratory furniture and consumables to schools, hospitals, research labs and factories in Abu Dhabi, Dubai and across the Emirates.</p>
      </div>

      <!-- CTA buttons -->
      <div class="hero-actions">
        <a href="/catalogue/analytical-equipments" class="hero-cta">
          <span class="hero-cta-text">Browse the catalogue</span>
          <span class="hero-cta-arrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
        <a href="/contact" class="hero-cta hero-cta-ghost">
          <span class="hero-cta-text">Talk to our team</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Chemical Atom Canvas Animation -->
  <script is:inline>
    (function () {
      const canvas = document.getElementById('atom-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let animId;
      let W, H, cx, cy;

      const products = [
        'ANALYTICAL EQUIPMENTS',
        'SCIENTIFIC EQUIPMENTS',
        'TESTING APPARATUS',
        'LAB FURNITURES',
        'CONSUMABLES',
        'TURNKEY PROJECTS'
      ];

      const orbits = [
        { rx: 130, ry: 44, rot: -20, speed: 0.15, electrons: 2 },
        { rx: 150, ry: 38, rot: 30, speed: 0.1, electrons: 2 },
        { rx: 115, ry: 52, rot: -55, speed: 0.2, electrons: 2 }
      ];

      function resize() {
        const wrap = canvas.parentElement;
        const dpr = window.devicePixelRatio || 1;
        const rect = wrap.getBoundingClientRect();
        W = rect.width;
        H = rect.height;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        cx = W * 0.5;
        cy = H * 0.5;
      }

      function drawOrbit(o, time) {
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate((o.rot * Math.PI) / 180);

        // Draw ellipse path
        ctx.beginPath();
        ctx.ellipse(0, 0, o.rx, o.ry, 0, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255,255,255,0.18)';
        ctx.lineWidth = 1;
        ctx.setLineDash([5, 7]);
        ctx.stroke();
        ctx.setLineDash([]);

        // Electrons
        for (let i = 0; i < o.electrons; i++) {
          const angle = time * o.speed + (i * Math.PI * 2) / o.electrons;
          const ex = Math.cos(angle) * o.rx;
          const ey = Math.sin(angle) * o.ry;

          // Electron glow
          const grad = ctx.createRadialGradient(ex, ey, 0, ex, ey, 16);
          grad.addColorStop(0, 'rgba(255,255,255,0.85)');
          grad.addColorStop(0.4, 'rgba(255,255,255,0.3)');
          grad.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(ex, ey, 16, 0, Math.PI * 2);
          ctx.fill();

          // Electron core
          ctx.fillStyle = '#fff';
          ctx.beginPath();
          ctx.arc(ex, ey, 4, 0, Math.PI * 2);
          ctx.fill();

          // Trail
          for (let t = 1; t <= 5; t++) {
            const ta = angle - t * 0.1 * o.speed;
            const tx = Math.cos(ta) * o.rx;
            const ty = Math.sin(ta) * o.ry;
            ctx.fillStyle = `rgba(255,255,255,${0.2 - t * 0.03})`;
            ctx.beginPath();
            ctx.arc(tx, ty, 2.5 - t * 0.35, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        ctx.restore();
      }

      function drawNucleus(time) {
        const pulse = 1 + Math.sin(time * 0.5) * 0.12;

        // Outer glow — large and bright
        const g1 = ctx.createRadialGradient(cx, cy, 0, cx, cy, 72 * pulse);
        g1.addColorStop(0, 'rgba(255,255,255,0.45)');
        g1.addColorStop(0.3, 'rgba(255,255,255,0.2)');
        g1.addColorStop(0.6, 'rgba(255,255,255,0.06)');
        g1.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = g1;
        ctx.beginPath();
        ctx.arc(cx, cy, 72 * pulse, 0, Math.PI * 2);
        ctx.fill();

        // Mid glow
        const gMid = ctx.createRadialGradient(cx, cy, 0, cx, cy, 32);
        gMid.addColorStop(0, 'rgba(255,255,255,0.7)');
        gMid.addColorStop(0.5, 'rgba(255,255,255,0.25)');
        gMid.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = gMid;
        ctx.beginPath();
        ctx.arc(cx, cy, 32, 0, Math.PI * 2);
        ctx.fill();

        // Inner glow — bright core
        const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, 13);
        g2.addColorStop(0, 'rgba(255,255,255,1)');
        g2.addColorStop(0.4, 'rgba(255,255,255,0.7)');
        g2.addColorStop(1, 'rgba(255,255,255,0)');
        ctx.fillStyle = g2;
        ctx.beginPath();
        ctx.arc(cx, cy, 13, 0, Math.PI * 2);
        ctx.fill();

        // Solid core
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.arc(cx, cy, 5, 0, Math.PI * 2);
        ctx.fill();
      }

      function drawLabels(time) {
        ctx.font = '500 10px "Geist Mono", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        products.forEach((label, i) => {
          const angle = (i * Math.PI * 2) / products.length - Math.PI / 2 + Math.sin(time * 0.2) * 0.03;
          const dist = 170 + Math.sin(time * 0.3 + i) * 8;
          const lx = cx + Math.cos(angle) * dist;
          const ly = cy + Math.sin(angle) * dist;

          // Connection line
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(lx, ly);
          ctx.strokeStyle = 'rgba(255,255,255,0.06)';
          ctx.lineWidth = 1;
          ctx.stroke();

          // Label background
          const metrics = ctx.measureText(label);
          const pad = 6;
          const bx = lx - metrics.width / 2 - pad;
          const by = ly - 8 - pad / 2;
          const bw = metrics.width + pad * 2;
          const bh = 16 + pad;
          const br = 3;
          ctx.fillStyle = 'rgba(255,255,255,0.07)';
          ctx.beginPath();
          ctx.moveTo(bx + br, by);
          ctx.lineTo(bx + bw - br, by);
          ctx.quadraticCurveTo(bx + bw, by, bx + bw, by + br);
          ctx.lineTo(bx + bw, by + bh - br);
          ctx.quadraticCurveTo(bx + bw, by + bh, bx + bw - br, by + bh);
          ctx.lineTo(bx + br, by + bh);
          ctx.quadraticCurveTo(bx, by + bh, bx, by + bh - br);
          ctx.lineTo(bx, by + br);
          ctx.quadraticCurveTo(bx, by, bx + br, by);
          ctx.closePath();
          ctx.fill();

          // Label text
          ctx.fillStyle = 'rgba(255,255,255,0.65)';
          ctx.fillText(label, lx, ly);
        });
      }

      function draw(time) {
        ctx.clearRect(0, 0, W, H);
        drawNucleus(time);
        orbits.forEach(o => drawOrbit(o, time));
        drawLabels(time);
        animId = requestAnimationFrame(() => draw(time + 0.016));
      }

      resize();
      draw(0);
      window.addEventListener('resize', () => {
        resize();
      }, { passive: true });
    })();
  </script>

  <!-- WHAT WE SUPPLY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we supply</span>
        <h2 class="section-title">Scientific equipment &amp; laboratory supplies</h2>
        <p class="section-subtitle">One supplier for every facility — instruments, furniture, consumables and complete projects, delivered and installed across the UAE.</p>
      </div>
      <div class="supply-grid">
        {supplyCards.map((card) => (
          <a href={`/catalogue/${card.id}`} class="supply-card">
            <div class="supply-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </div>
            <h3 class="supply-title">{card.name}</h3>
            <p class="supply-desc">{card.desc}</p>
            <span class="supply-link">Browse {card.name} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILT FOR EVERY SECTOR -->
  <section class="sector-section">
    <div class="sector-wrap">
      <div class="sector-left">
        <h2 class="sector-heading">Built for every<br />sector</h2>
        <p class="sector-desc">One supplier for schools, hospitals, labs, and factories across the UAE.</p>
        <div class="sector-list">
          <button class="sector-item active" data-sector="education">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            Education &amp; Schools
          </button>
          <button class="sector-item" data-sector="healthcare">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M12 14v4"/><path d="M10 16h4"/></svg>
            </span>
            Healthcare &amp; Hospitals
          </button>
          <button class="sector-item" data-sector="research">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
            </span>
            Research Laboratories
          </button>
          <button class="sector-item" data-sector="industrial">
            <span class="sector-item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            Industrial &amp; Factory
          </button>
        </div>
      </div>
      <div class="sector-right">
        <div class="sector-panel">
          <div id="sector-result">
            <h3 class="sector-result-title">Education &amp; Schools</h3>
            <p class="sector-result-subtitle">Equipping classrooms and school laboratories across the UAE</p>
            <div class="sector-result-tag">Key Products</div>
            <div class="sector-result-list">
              <div class="sector-product">
                <p class="sector-product-name">Laboratory Workstations</p>
                <p class="sector-product-desc">Modular bench systems with chemical-resistant tops</p>
              </div>
              <div class="sector-product">
                <p class="sector-product-name">Fume Hoods</p>
                <p class="sector-product-desc">Ducted and ductless models, EN 14175 certified</p>
              </div>
              <div class="sector-product">
                <p class="sector-product-name">Student Desks &amp; Seating</p>
                <p class="sector-product-desc">Adjustable-height lab desks, powder-coated steel frames</p>
              </div>
              <div class="sector-product">
                <p class="sector-product-name">Safety Cabinets</p>
                <p class="sector-product-desc">Eye-wash stations, fire extinguishers, first-aid kits</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const sectorData = {
      education: {
        title: "Education & Schools",
        subtitle: "Equipping classrooms and school laboratories across the UAE",
        products: [
          { name: "Laboratory Workstations", detail: "Modular bench systems with chemical-resistant tops" },
          { name: "Fume Hoods", detail: "Ducted and ductless models, EN 14175 certified" },
          { name: "Student Desks & Seating", detail: "Adjustable-height lab desks, powder-coated steel frames" },
          { name: "Safety Cabinets", detail: "Eye-wash stations, fire extinguishers, first-aid kits" }
        ]
      },
      healthcare: {
        title: "Healthcare & Hospitals",
        subtitle: "Medical furniture and equipment for healthcare facilities",
        products: [
          { name: "Hospital Beds", detail: "Electric and manual models with side rails" },
          { name: "Medical Carts", detail: "Crash carts, procedure carts, IV poles, stainless steel" },
          { name: "Sterile Storage Cabinets", detail: "Laminar flow cabinets and clean-room shelving" },
          { name: "Examination Tables", detail: "Adjustable height, vinyl upholstery" }
        ]
      },
      research: {
        title: "Research Laboratories",
        subtitle: "Precision equipment for research institutions",
        products: [
          { name: "Analytical Instruments", detail: "Spectrophotometers, balances, centrifuges" },
          { name: "ESD Workbenches", detail: "Anti-static surfaces for electronics labs" },
          { name: "Chemical Storage", detail: "Flammable cabinets, corrosive storage, EN 14470 certified" },
          { name: "Fume Extraction", detail: "Bench-top and ceiling-mounted systems" }
        ]
      },
      industrial: {
        title: "Industrial & Factory",
        subtitle: "Testing and workspace solutions for manufacturing",
        products: [
          { name: "Testing Equipment", detail: "Tensile testers, hardness testers, gauges" },
          { name: "Heavy-Duty Workbenches", detail: "Steel-frame benches with 500kg load capacity" },
          { name: "Calibration Tools", detail: "Reference standards and calibration kits" },
          { name: "Tool Storage", detail: "Industrial cabinets, shadow boards" }
        ]
      }
    };

    document.querySelectorAll('.sector-item').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sector-item').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const key = btn.dataset.sector;
        const data = sectorData[key];
        const result = document.getElementById('sector-result');
        result.querySelector('.sector-result-title').textContent = data.title;
        result.querySelector('.sector-result-subtitle').textContent = data.subtitle;
        const list = result.querySelector('.sector-result-list');
        list.innerHTML = data.products.map(p => `
          <div class="sector-product">
            <p class="sector-product-name">${p.name}</p>
            <p class="sector-product-desc">${p.detail}</p>
          </div>
        `).join('');
      });
    });
  </script>

