---
import Layout from '../layouts/Layout.astro';
import productData from '../data/jas-products.json';
---

<Layout title="Products — TAKA Scientific">
  <section class="page-hero" id="search">
    <div class="container">
      <div class="hero-top">
        <div>
          <span class="eyebrow">Catalog</span>
          <h1 class="page-hero-title">Products</h1>
        </div>
        <span class="hero-count">{productData.categories.reduce((sum, c) => sum + c.products.length, 0)}</span>
      </div>
      <div class="hero-toolbar">
        <div class="search-field">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="productSearch" class="search-input" placeholder="Filter products..." aria-label="Search products" />
          <span class="search-results-count" id="searchResultsCount"></span>
        </div>
        <div class="filter-pills" id="categoryFilters">
          <button class="filter-pill active" data-filter="all">All</button>
          {productData.categories.map(cat => (
            <button class="filter-pill" data-filter={cat.id}>{cat.shortName}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  {productData.categories.map((cat, catIndex) => (
    <section class="section" id={`cat-${cat.id}`} style={catIndex % 2 === 1 ? 'background: var(--color-surface);' : ''}>
      <div class="container">
        <div style="margin-bottom: 2rem;">
          <h2 class="section-title">{cat.name}</h2>
          <p class="section-subtitle">{cat.description}</p>
        </div>
        <div class="products-grid">
          {cat.products.map((product) => (
            <div class="product-card" id={`product-${product.id}`} data-category={cat.id} data-search={`${product.name} ${product.fullName || ''} ${product.description} ${(product.features || []).join(' ')} ${(product.applications || []).join(' ')}`.toLowerCase()}>
              <div class="product-card-top">
                <h3 class="product-card-title">{product.name}</h3>
                <span class="product-card-arrow" aria-hidden="true">→</span>
              </div>
              <div class="product-card-specs">
                {product.specs.map(spec => (
                  <div class="spec-row">
                    <span class="spec-key">{spec.key}:</span>
                    <span class="spec-value">{spec.value}</span>
                  </div>
                ))}
              </div>
              <div class="product-card-image">
                <img src={product.image} alt={product.name} loading="lazy" />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="cta-section">
    <div class="container text-center">
      <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: 1.25rem;">Need a quote? Tell us about your facility and requirements.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/971557566123" target="_blank" class="btn btn-outline">WhatsApp</a>
        <a href="/contact" class="btn btn-outline">Contact form</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 0;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .page-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    color: var(--color-text);
    line-height: 1.1;
    margin-top: 0.5rem;
  }
  .hero-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .hero-toolbar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .search-field svg { color: var(--color-text-muted); flex-shrink: 0; }
  .search-input {
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text);
    background: transparent;
    width: 180px;
    transition: width 0.15s;
  }
  .search-input:focus { width: 260px; }
  .search-input::placeholder { color: var(--color-text-muted); }
  .search-results-count {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .search-results-count:empty { display: none; }
  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex: 1;
  }
  .filter-pill {
    padding: 0.3rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .filter-pill:hover { color: var(--color-text); border-color: var(--color-border); }
  .filter-pill.active {
    background: var(--color-text);
    color: #fff;
    border-color: var(--color-text);
  }

  /* Products grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .product-card {
    background: #fff;
    display: flex;
    flex-direction: column;
    transition: background 0.15s;
    overflow: hidden;
  }
  .product-card:hover { background: var(--color-surface); }
  .product-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 0;
    gap: 0.75rem;
  }
  .product-card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
    flex: 1;
  }
  .product-card-arrow {
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 1.1rem;
    opacity: 0.3;
    transition: opacity 0.15s, transform 0.15s;
    margin-top: 2px;
  }
  .product-card:hover .product-card-arrow {
    opacity: 0.7;
    transform: translateX(3px);
  }
  .product-card-specs {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .spec-row {
    display: flex;
    gap: 0.5rem;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .spec-key { color: var(--color-text-muted); white-space: nowrap; }
  .spec-value { color: var(--color-text); font-weight: 600; }
  .product-card-image {
    background: var(--color-surface);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
  }
  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    transition: transform 0.3s;
  }
  .product-card:hover .product-card-image img { transform: scale(1.03); }

  .hidden { display: none !important; }

  @media (max-width: 1024px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .page-hero { padding: 2.5rem 0 0; }
    .page-hero-title { font-size: 1.6rem; }
    .hero-toolbar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .search-input { width: 100%; }
    .search-input:focus { width: 100%; }
    .products-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('productSearch') as HTMLInputElement;
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    const sections = document.querySelectorAll<HTMLElement>('section[id^="cat-"]');
    const count = document.getElementById('searchResultsCount');
    let filter = 'all';
    let timer: ReturnType<typeof setTimeout>;

    function apply() {
      const q = searchInput.value.toLowerCase().trim();
      let n = 0;
      const vis = new Set<string>();
      cards.forEach(c => {
        const hit = (!q || (c.dataset.search || '').includes(q)) && (filter === 'all' || c.dataset.category === filter);
        c.classList.toggle('hidden', !hit);
        if (hit) { n++; vis.add(c.dataset.category || ''); }
      });
      sections.forEach(s => {
        const id = s.id.replace('cat-', '');
        s.classList.toggle('hidden', (q || filter !== 'all') && !vis.has(id));
      });
      count.textContent = (q || filter !== 'all') ? `${n} product${n !== 1 ? 's' : ''}` : '';
    }

    searchInput.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(apply, 120);
    });

    pills.forEach(p => {
      p.addEventListener('click', () => {
        pills.forEach(b => b.classList.remove('active'));
        p.classList.add('active');
        filter = p.dataset.filter || 'all';
        apply();
      });
    });
  });
</script>
